/* pages/home/home.wxss */
.home-page { padding-bottom: 40rpx; }

/* 注册待审核 */
.pending-page { padding: 80rpx 32rpx; }
.pending-card { text-align: center; padding: 60rpx 40rpx; }
.pending-icon { font-size: 96rpx; display: block; }
.pending-title { font-size: 36rpx; font-weight: 700; color: #333; display: block; margin-top: 24rpx; }
.pending-desc { font-size: 28rpx; color: #666; line-height: 1.7; display: block; margin-top: 20rpx; }
.pending-tip { font-size: 24rpx; color: #999; margin-top: 24rpx; display: block; background: #f5f5f5; border-radius: 12rpx; padding: 16rpx; }

/* 用户卡片 */
.user-card { padding: 24rpx 32rpx; }
.user-info { display: flex; align-items: center; }
.user-avatar {
  width: 96rpx; height: 96rpx; border-radius: 50%;
  background: #f0f0f0; flex-shrink: 0;
}
.user-detail { flex: 1; margin-left: 24rpx; }
.user-name { font-size: 34rpx; font-weight: 600; color: #333; }
.user-meta { display: flex; gap: 12rpx; margin-top: 8rpx; }
.arrow { font-size: 40rpx; color: #ccc; }

.stats-row { display: flex; margin-top: 28rpx; padding-top: 24rpx; border-top: 1rpx solid #f0f0f0; }
.stat-item { flex: 1; text-align: center; }
.stat-num { font-size: 30rpx; font-weight: 600; color: #333; display: block; }
.stat-num.highlight { color: #ff9800; }
.stat-label { font-size: 22rpx; color: #999; margin-top: 4rpx; display: block; }

.logout-wrap { text-align: center; margin-top: 16rpx; padding-top: 16rpx; border-top: 1rpx solid #f0f0f0; }
.logout-btn { font-size: 24rpx; color: #999; padding: 8rpx 24rpx; }

/* 功能区 */
.section-title {
  font-size: 30rpx; font-weight: 600; color: #333;
  padding: 32rpx 24rpx 16rpx;
}

.menu-grid { display: flex; flex-wrap: wrap; padding: 0 12rpx; }
.menu-item {
  flex: 0 0 calc(50% - 24rpx); box-sizing: border-box;
  margin: 12rpx; padding: 40rpx 16rpx; text-align: center;
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  min-height: 130rpx;
}
.menu-icon { font-size: 48rpx; display: block; }
.menu-text { font-size: 28rpx; font-weight: 600; color: #333; margin-top: 12rpx; }
.menu-desc { font-size: 22rpx; color: #999; margin-top: 6rpx; }

.menu-item.disabled { opacity: 0.5; }

.signin-status { font-size: 20rpx; color: #ff6b00; margin-top: 6rpx; }
.signin-status.done { color: #1aad19; }
.beta-tag { font-size: 22rpx; color: #ff9800; font-weight: 400; margin-left: 8rpx; }

/* ===== 游客模式 ===== */
.guest-page { padding: 0 24rpx 40rpx; }

.guest-welcome { text-align: center; padding: 48rpx 32rpx; }
.guest-title { font-size: 36rpx; font-weight: 700; color: #333; display: block; }
.guest-subtitle { font-size: 26rpx; color: #999; margin-top: 12rpx; display: block; }

/* 联盟介绍 */
.guest-intro { padding: 32rpx; }
.intro-header { margin-bottom: 20rpx; }
.intro-title { font-size: 32rpx; font-weight: 700; color: #1aad19; display: block; }
.intro-slogan { font-size: 24rpx; color: #666; margin-top: 8rpx; display: block; font-style: italic; }
.intro-body {
  font-size: 26rpx; color: #444; line-height: 1.8;
  display: block; white-space: pre-line;
}

/* 联系方式 */
.intro-contact {
  margin-top: 24rpx; padding-top: 20rpx;
  border-top: 2rpx solid #f0f0f0;
  display: flex; align-items: center;
}
.contact-label { font-size: 26rpx; color: #666; flex-shrink: 0; }
.contact-value-wrap {
  display: flex; align-items: center; gap: 12rpx;
  background: #f5f5f5; padding: 8rpx 16rpx; border-radius: 8rpx;
}
.contact-value { font-size: 26rpx; color: #333; font-weight: 600; }
.contact-copy {
  font-size: 22rpx; color: #fff; background: #1aad19;
  padding: 4rpx 16rpx; border-radius: 6rpx;
}

/* 登录引导 */
.guest-login {
  display: flex; align-items: center; justify-content: space-between;
  padding: 32rpx; margin-top: 24rpx; background: linear-gradient(135deg, #1aad19, #4caf50);
}
.login-text { font-size: 26rpx; color: #fff; flex: 1; }
.login-arrow { font-size: 40rpx; color: rgba(255,255,255,0.8); margin-left: 16rpx; }
