/* pages/records/certificates.wxss - 我的证书 */
.page { padding: 24rpx; padding-bottom: 60rpx; }
.loading, .empty { text-align: center; color: #999; font-size: 28rpx; padding: 40rpx 0; }
.notice { background: #eef6ff; color: #2b6cb0; border-radius: 12rpx; padding: 20rpx 24rpx; font-size: 26rpx; margin-bottom: 20rpx; }

.card { background: #fff; border-radius: 16rpx; padding: 24rpx; margin-bottom: 24rpx; box-shadow: 0 2rpx 12rpx rgba(0,0,0,.06); }

/* 顶部 tab（与跑马记录页一致）：项目名 + 场次，选中绿色下划线 */
.tabs { display: flex; background: #fff; position: sticky; top: 0; z-index: 10; margin-bottom: 20rpx; }
.tab { flex: 1; text-align: center; padding: 24rpx; font-size: 28rpx; color: #666; border-bottom: 4rpx solid transparent; }
.tab.active { color: #1aad19; border-color: #1aad19; font-weight: bold; }
.tab-num { font-size: 22rpx; color: #bbb; margin-left: 6rpx; font-weight: normal; }
.tab.active .tab-num { color: #1aad19; }
.tab-gear { flex: 0 0 72rpx; text-align: center; padding: 24rpx 0; font-size: 30rpx; border-bottom: 4rpx solid transparent; }

/* 添加入口：放在统计条下面一行 */
.add-line { display: flex; align-items: center; background: #fff; border-radius: 16rpx; padding: 26rpx 24rpx; margin-bottom: 24rpx; box-shadow: 0 2rpx 12rpx rgba(0,0,0,.06); }
.add-plus { font-size: 34rpx; color: #1aad19; font-weight: 600; margin-right: 10rpx; }
.add-text { font-size: 30rpx; color: #222; font-weight: 500; }
.add-sub { font-size: 24rpx; color: #aaa; margin-left: 8rpx; }
.stat-num { font-size: 44rpx; font-weight: 600; color: #222; display: block; }
.stat-label { font-size: 24rpx; color: #999; display: block; margin-top: 6rpx; }

/* PB 角标：打在卡片右上角 */
.pb-corner { position: absolute; top: 0; right: 0; background: linear-gradient(135deg, #ffb74d, #f57c00); color: #fff; font-size: 22rpx; font-weight: 600; padding: 8rpx 18rpx; border-radius: 0 16rpx 0 16rpx; }

.cert-hint { font-size: 24rpx; color: #bbb; margin-left: 8rpx; }
/* 能点的提示：做成绿色带下划线，别让人以为是死的灰字 */
.link { color: #1aad19; text-decoration: underline; }

/* 项目分区 */
.group { margin-bottom: 4rpx; }
.group-title { font-size: 30rpx; font-weight: 600; color: #333; padding: 20rpx 8rpx 8rpx; display: flex; align-items: center; justify-content: space-between; }

.cert-card { position: relative; } /* PB 角标要相对卡片定位 */
.cert-head { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 16rpx; }
.cert-name { font-size: 32rpx; font-weight: 600; color: #222; flex: 1; }
.cert-date { font-size: 24rpx; color: #999; margin-left: 16rpx; }
.cert-imgs { display: flex; flex-wrap: wrap; }
/* 列表里只放缩略图，点开才是大图（原图），避免一屏被几张证书图占满 */
.cert-thumb { width: 200rpx; height: 200rpx; border-radius: 12rpx; margin-right: 16rpx; margin-bottom: 12rpx; }
.cert-tip { font-size: 22rpx; color: #bbb; margin-top: -4rpx; }
.cert-noimg { color: #bbb; font-size: 26rpx; padding: 20rpx 0; }
.cert-meta { display: flex; flex-wrap: wrap; margin-top: 12rpx; }
.meta-item { font-size: 26rpx; color: #555; margin-right: 24rpx; margin-bottom: 8rpx; }
.cert-note { font-size: 26rpx; color: #777; margin-top: 12rpx; line-height: 1.6; }
.cert-actions { display: flex; justify-content: flex-end; margin-top: 16rpx; border-top: 2rpx solid #f2f2f2; padding-top: 16rpx; }

.mini-btn { padding: 10rpx 28rpx; border-radius: 999rpx; background: #1aad19; color: #fff; font-size: 26rpx; margin-left: 16rpx; }
.mini-ghost { background: #f2f2f2; color: #555; }
.mini-btn.del { color: #e74c3c; }

.btn { background: #1aad19; color: #fff; font-size: 30rpx; border-radius: 12rpx; padding: 0 24rpx; height: 88rpx; line-height: 88rpx; }
.btn::after { border: none; }
.btn-gray { background: #f2f2f2; color: #555; }
.add-btn { margin-top: 8rpx; }

/* 弹窗（与跑马记录页一致：遮罩 fixed 铺满，弹窗自己 fixed + 更高层级，
   否则弹窗会被遮罩盖住，点了齿轮只看到页面变灰却看不到内容） */
.modal-mask { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,.4); z-index: 100; }
.modal-box { position: fixed; top: 25%; left: 40rpx; right: 40rpx; background: #fff; border-radius: 16rpx; padding: 32rpx 24rpx; z-index: 101; max-height: 70vh; overflow-y: auto; }
.modal-title { font-size: 34rpx; font-weight: 600; display: block; margin-bottom: 24rpx; }
.modal-btns { display: flex; margin-top: 28rpx; }
.modal-btns .btn { flex: 1; margin: 0 8rpx; }

.field { margin-bottom: 24rpx; }
.field-label { font-size: 26rpx; color: #666; display: block; margin-bottom: 12rpx; }
.input { background: #f7f7f7; border-radius: 10rpx; padding: 20rpx; font-size: 28rpx; }
.textarea { background: #f7f7f7; border-radius: 10rpx; padding: 20rpx; font-size: 28rpx; width: auto; min-height: 120rpx; }
.row-value { font-size: 28rpx; color: #333; background: #f7f7f7; border-radius: 10rpx; padding: 20rpx; display: block; }
.card-sub { font-size: 24rpx; color: #999; display: block; margin-top: 12rpx; line-height: 1.6; }

.name-row { display: flex; align-items: center; }
.name-row .tag { margin-left: 16rpx; }
.tag { font-size: 24rpx; padding: 8rpx 20rpx; border-radius: 8rpx; background: #f2f2f2; color: #555; }
.tag-blue { background: #e7f1ff; color: #2b6cb0; }
.tag-green { background: #e6f7ec; color: #1aad19; }
.tag-gray { background: #f2f2f2; color: #aaa; }

.chip-row { display: flex; flex-wrap: wrap; }
.chip { font-size: 26rpx; padding: 12rpx 28rpx; border-radius: 999rpx; background: #f2f2f2; color: #555; margin-right: 16rpx; margin-bottom: 12rpx; }
.chip.on { background: #1aad19; color: #fff; }

/* 图片选择 */
.photo-row { display: flex; flex-wrap: wrap; }
.photo-cell { position: relative; }
.img-preview { width: 180rpx; height: 180rpx; border-radius: 12rpx; margin-right: 16rpx; margin-bottom: 16rpx; }
.upload-box { width: 180rpx; height: 180rpx; border: 2rpx dashed #ccc; border-radius: 12rpx; display: flex; align-items: center; justify-content: center; color: #aaa; font-size: 26rpx; }
.photo-del { position: absolute; top: 0; right: 16rpx; width: 40rpx; height: 40rpx; line-height: 36rpx; text-align: center; border-radius: 50%; background: rgba(0,0,0,.55); color: #fff; font-size: 28rpx; }

/* 赛事选择列表 */
.event-row { padding: 20rpx 0; border-bottom: 2rpx solid #f2f2f2; }
.member-info { flex: 1; }
.member-name { font-size: 30rpx; color: #222; display: block; }
.member-meta { font-size: 24rpx; color: #999; display: block; margin-top: 6rpx; }
