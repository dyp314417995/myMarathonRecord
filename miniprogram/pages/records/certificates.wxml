<!-- pages/records/certificates.wxml - 我的荣耀时刻（数据来自跑马记录中已完赛的部分） -->
<view class="page">
  <view class="loading" wx:if="{{loading}}">加载中…</view>

  <block wx:else>
    <!-- 看别人的荣耀墙时的说明条 -->
    <view class="notice" wx:if="{{!mine}}">🏅 {{ownerName ? ownerName + ' 的' : 'TA 的'}}荣耀时刻 · 共 {{total}} 场完赛</view>

    <!-- 顶部统计 -->
    <view class="stat-bar" wx:if="{{stats.length}}">
      <view class="stat-cell" wx:for="{{stats}}" wx:key="label">
        <text class="stat-num">{{item.count}}</text>
        <text class="stat-label">{{item.label}}</text>
      </view>
    </view>

    <!-- 按项目分区：全马 / 半马 / 10 公里 / 其他，每组内比赛时间倒序 -->
    <view class="group" wx:for="{{groups}}" wx:key="key">
      <view class="group-title">{{item.label}} · {{item.count}} 场</view>

      <view class="cert-card card" wx:for="{{item.list}}" wx:for-item="r" wx:key="_id">
        <view class="cert-head">
          <text class="cert-name">{{r.city}}</text>
          <text class="cert-date">{{r.date || '日期未填'}}</text>
        </view>

        <view class="cert-imgs" wx:if="{{r.showUrls.length}}">
          <image wx:for="{{r.showUrls}}" wx:for-item="u" wx:key="*this"
                 class="cert-thumb" src="{{u}}" mode="aspectFill"
                 data-id="{{r._id}}" data-url="{{u}}" bindtap="onPreviewImage" />
        </view>
        <view wx:else class="cert-noimg">（还没传图片，可在跑马记录里补上成绩截图或证书）</view>
        <view class="cert-tip" wx:if="{{r.showUrls.length}}">点图片看大图</view>

        <view class="cert-meta">
          <text class="meta-item" wx:if="{{r.result}}">⏱ {{r.result}}</text>
          <text class="meta-item" wx:if="{{r.rank}}">🏆 {{r.rank}}</text>
          <text class="meta-item" wx:if="{{r.distanceKm}}">📏 {{r.distanceKm}} 公里</text>
          <text class="tag tag-green" wx:if="{{r.isPB}}">PB</text>
        </view>
        <view class="cert-note" wx:if="{{r.note}}">{{r.note}}</view>

        <view class="cert-actions" wx:if="{{mine}}">
          <text class="mini-btn mini-ghost" data-id="{{r._id}}" bindtap="onEdit">编辑</text>
          <text class="cert-hint">要删除请到「跑马记录」</text>
        </view>
      </view>
    </view>

    <view class="empty" wx:if="{{total === 0}}">
      {{mine ? '还没有已完赛的记录，去跑马记录里添加一条吧' : 'TA 还没有完赛记录'}}
    </view>

    <button class="btn add-btn" wx:if="{{mine}}" bindtap="onAdd">＋ 添加荣耀时刻</button>
    <button class="btn btn-gray" wx:if="{{mine && total > 0}}" bindtap="onGoRecords">去跑马记录补证书 / 成绩</button>
  </block>

  <!-- 添加 / 编辑 -->
  <view class="modal-mask" wx:if="{{showForm}}" bindtap="onCloseForm">
    <view class="modal-box" catchtap="noop">
      <text class="modal-title">{{editingId ? '编辑' : '添加'}}荣耀时刻</text>
      <text class="card-sub">这会写成一条「已完赛」的跑马记录，两边通用，不用重复录入。</text>

      <view class="field">
        <text class="field-label">赛事名称 *</text>
        <view class="name-row">
          <input class="input" style="flex:1" value="{{form.city}}" data-f="city" bindinput="onInput" placeholder="如：2026 北京马拉松" />
          <text class="tag tag-blue" bindtap="onOpenEventPicker">从我的赛事选</text>
        </view>
      </view>

      <view class="field">
        <text class="field-label">完赛成绩 *</text>
        <input class="input" value="{{form.result}}" data-f="result" bindinput="onInput" placeholder="如 3:30:00" />
      </view>

      <view class="field">
        <text class="field-label">完赛日期</text>
        <picker mode="date" value="{{form.date}}" bindchange="onDateChange">
          <text class="row-value">{{form.date}} ›</text>
        </picker>
      </view>

      <view class="field">
        <text class="field-label">项目</text>
        <view class="chip-row">
          <text class="chip {{form.raceType === 'full' ? 'on' : ''}}" data-type="full" bindtap="onPickType">全马</text>
          <text class="chip {{form.raceType === 'half' ? 'on' : ''}}" data-type="half" bindtap="onPickType">半马</text>
          <text class="chip {{form.raceType === '10k' ? 'on' : ''}}" data-type="10k" bindtap="onPickType">10 公里</text>
          <text class="chip {{form.raceType === 'custom' ? 'on' : ''}}" data-type="custom" bindtap="onPickType">其他</text>
        </view>
      </view>

      <view class="field">
        <text class="field-label">名次 / 荣誉</text>
        <input class="input" value="{{form.rank}}" data-f="rank" bindinput="onInput" placeholder="如 年龄组第 8 / 破三" />
      </view>

      <view class="field">
        <text class="field-label">证书图片（最多 3 张）</text>
        <view class="photo-row">
          <view class="photo-cell" wx:for="{{formCertImages}}" wx:key="index">
            <image class="img-preview" src="{{item.previewUrl}}" mode="aspectFill" data-i="{{index}}" bindtap="onPreviewFormImage" />
            <text class="photo-del" data-i="{{index}}" catchtap="onRemoveImage">×</text>
          </view>
          <view wx:if="{{formCertImages.length < 3}}" class="upload-box" bindtap="onChooseImage">＋ 选图</view>
        </view>
      </view>

      <view class="field">
        <text class="field-label">备注</text>
        <textarea class="textarea" value="{{form.note}}" data-f="note" bindinput="onInput" placeholder="当时的感受、天气、配速…（选填）"></textarea>
      </view>

      <view class="modal-btns">
        <button class="btn btn-gray" bindtap="onCloseForm">取消</button>
        <button class="btn" loading="{{saving}}" bindtap="onSave">保存</button>
      </view>
    </view>
  </view>

  <!-- 我的赛事选择 -->
  <view class="modal-mask" wx:if="{{showEventPicker}}" bindtap="onCloseEventPicker">
    <view class="modal-box" catchtap="noop">
      <text class="modal-title">从我的赛事里选</text>
      <text class="card-sub">选完会自动带出赛事信息和已记录的成绩；没有想要的赛事，关掉这里直接填名称就行</text>
      <view class="loading" wx:if="{{eventsLoading}}">加载中…</view>
      <view class="empty" wx:elif="{{myEvents.length === 0}}">你还没有关注任何赛事</view>
      <view class="event-row" wx:for="{{myEvents}}" wx:key="_id" data-id="{{item._id}}" bindtap="onPickEvent">
        <view class="member-info">
          <text class="member-name">{{item.name}}</text>
          <text class="member-meta">{{item.date || '日期待定'}}{{item.city ? ' · ' + item.city : ''}}</text>
        </view>
        <view class="member-right">
          <text class="tag {{item.hasResult ? 'tag-green' : 'tag-gray'}}">{{item.hasResult ? item.result : '未录成绩'}}</text>
        </view>
      </view>
      <view class="modal-btns">
        <button class="btn btn-gray" bindtap="onCloseEventPicker">关闭</button>
      </view>
    </view>
  </view>
</view>
