<!-- pages/points/admin.wxml -->
<view class="admin-page">
  <!-- Tab -->
  <view class="tabs">
    <view class="tab {{tab === 'rules' ? 'active' : ''}}" data-tab="rules" bindtap="onTabChange">规则</view>
    <view class="tab {{tab === 'review' ? 'active' : ''}}" data-tab="review" bindtap="onTabChange">审批</view>
    <view class="tab {{tab === 'record' ? 'active' : ''}}" data-tab="record" bindtap="onTabChange">录入/扣减</view>
    <view class="tab" bindtap="onGoApply">+申请</view>
  </view>

  <!-- 规则管理 -->
  <block wx:if="{{tab === 'rules'}}">
    <view wx:if="{{isSuperAdmin}}" class="rule-add-btn" bindtap="onAddRule">+ 新增规则</view>
    <view wx:if="{{isSuperAdmin}}" class="rule-tip">自动发放类规则（注册赠送 / 集体活动 / 赛事评分奖励）被禁用或删除后，对应发放即停发（不再按兜底积分执行）。</view>
    <view wx:for="{{rules}}" wx:key="_id" class="card rule-card">
      <view class="rule-row">
        <view class="rule-info">
          <view class="rule-title-row">
            <text class="rule-name">{{item.name}}</text>
            <text class="rule-submit {{item.submitText === '用户可提交' ? '' : 'off'}}">{{item.submitText}}</text>
          </view>
          <text class="rule-meta">+{{item.points}}分{{item.limitText ? ' · ' + item.limitText : ''}}</text>
        </view>
        <view class="rule-ops" wx:if="{{isSuperAdmin}}">
          <text class="rule-op" data-id="{{item._id}}" bindtap="onEditRule">编辑</text>
          <text class="rule-op del" data-id="{{item._id}}" bindtap="onDeleteRule">删除</text>
          <text class="rule-status {{item.status === 'active' ? 'on' : 'off'}}"
                data-id="{{item._id}}" data-status="{{item.status}}"
                bindtap="onToggleRuleStatus">{{item.status === 'active' ? '已启用' : '已禁用'}}</text>
        </view>
        <text wx:else class="rule-status {{item.status === 'active' ? 'on' : 'off'}}">{{item.status === 'active' ? '已启用' : '已禁用'}}</text>
      </view>
    </view>

    <!-- 规则编辑弹窗 -->
    <view class="modal-mask" wx:if="{{showRuleForm}}" catchtap="onHideRuleForm"></view>
    <view class="modal-box rule-modal" wx:if="{{showRuleForm}}">
      <text class="modal-title">{{editingRuleId ? '编辑规则' : '新增规则'}}</text>
      <scroll-view scroll-y style="flex:1; height:0; min-height:0;">
        <view class="form-group">
          <text class="form-label">规则名称 *（三个固定自动发放类型：注册赠送 / 集体活动 / 赛事评分奖励）</text>
          <input class="form-input" placeholder="如：邀请跑友加入" value="{{ruleForm.name}}" data-k="name" bindinput="onRuleInput" />
          <text wx:if="{{ruleForm.name === '注册赠送' || ruleForm.name === '集体活动' || ruleForm.name === '赛事评分奖励'}}" class="form-tip">固定自动发放类型，请勿改名，否则对应发放将按兜底积分执行</text>
        </view>
        <view class="form-group">
          <text class="form-label">规则描述（详细阐述，用户点击规则名可查看）</text>
          <textarea class="form-textarea" maxlength="50" placeholder="详细说明该规则的获取方式、条件等（50字以内）" value="{{ruleForm.description}}" data-k="description" bindinput="onRuleInput" />
        </view>
        <view class="form-group">
          <text class="form-label">是否需要用户提交</text>
          <view class="rule-period-row">
            <text class="rule-period {{ruleForm.needSubmit ? 'on' : ''}}" data-v="1" bindtap="onRuleNeedSubmit">需要（申请页可选）</text>
            <text class="rule-period {{!ruleForm.needSubmit ? 'on' : ''}}" data-v="0" bindtap="onRuleNeedSubmit">不需要（自动发放/管理员录入）</text>
          </view>
        </view>
        <view class="form-group">
          <text class="form-label">积分值 *</text>
          <input class="form-input" type="number" placeholder="正整数" value="{{ruleForm.points}}" data-k="points" bindinput="onRuleInput" />
        </view>
        <view class="form-group" wx:if="{{ruleForm.needSubmit}}">
          <text class="form-label">单次可提交数量（默认1；大于1时申请页可选择数量）</text>
          <input class="form-input" type="number" placeholder="如：10" value="{{ruleForm.maxQty}}" data-k="maxQty" bindinput="onRuleInput" />
        </view>
        <view class="form-group" wx:if="{{ruleForm.name === '注册赠送'}}">
          <text class="form-label">注册赠送随机范围（可选，填写后每次注册赠送在该区间内随机，抢红包效果）</text>
          <view class="rule-range-row">
            <input class="form-input" type="number" placeholder="最小值" value="{{ruleForm.minPoints}}" data-k="minPoints" bindinput="onRuleInput" />
            <text class="rule-range-sep">~</text>
            <input class="form-input" type="number" placeholder="最大值" value="{{ruleForm.maxPoints}}" data-k="maxPoints" bindinput="onRuleInput" />
          </view>
        </view>
        <view class="form-group" wx:if="{{ruleForm.needSubmit}}">
          <text class="form-label">提交周期</text>
          <view class="rule-period-row">
            <text wx:for="{{periodOptions}}" wx:key="v"
                  class="rule-period {{ruleForm.period === item.v ? 'on' : ''}}"
                  data-v="{{item.v}}" bindtap="onRulePeriod">{{item.t}}</text>
          </view>
        </view>
        <view class="form-group" wx:if="{{ruleForm.needSubmit && ruleForm.period}}">
          <text class="form-label">次数限制（1~10）</text>
          <input class="form-input" type="number" placeholder="如：4" value="{{ruleForm.limitCount}}" data-k="limitCount" bindinput="onRuleInput" />
        </view>
        <view class="form-group">
          <text class="form-label">状态</text>
          <view class="rule-period-row">
            <text class="rule-period {{ruleForm.status === 'active' ? 'on' : ''}}" data-v="active" bindtap="onRuleStatus">启用</text>
            <text class="rule-period {{ruleForm.status === 'disabled' ? 'on' : ''}}" data-v="disabled" bindtap="onRuleStatus">禁用</text>
          </view>
        </view>
      </scroll-view>
      <view class="rule-modal-actions">
        <button class="btn-outline" bindtap="onHideRuleForm" style="flex:1;">取消</button>
        <button class="btn-primary" bindtap="onSaveRule" style="flex:1; margin-left:20rpx;">保存</button>
      </view>
    </view>
  </block>

  <!-- 审批 -->
  <block wx:if="{{tab === 'review'}}">
    <!-- 子 Tab -->
    <view class="sub-tabs">
      <view class="sub-tab {{reviewSub === 'pending' ? 'active' : ''}}" data-v="pending" bindtap="onReviewSub">待审核</view>
      <view class="sub-tab {{reviewSub === 'done' ? 'active' : ''}}" data-v="done" bindtap="onReviewSub">已审核</view>
    </view>

    <!-- 待审核 -->
    <block wx:if="{{reviewSub === 'pending'}}">
      <!-- 积分审批 -->
      <view wx:if="{{pendingList.length === 0}}" class="empty-tight"><text>暂无待审批积分申请</text></view>
      <block wx:for="{{pendingList}}" wx:key="_id">
        <view class="card review-card">
          <view class="req-header">
            <text class="req-name">{{item.userName}}</text>
            <text class="tag tag-orange">待审批</text>
          </view>
          <text class="req-cat">{{item.category}} {{item.fmtPoints}}分</text>
          <text class="req-desc">{{item.description || '无说明'}}</text>
          <text class="req-id">单号 {{item.fmtId}}</text>
          <text class="req-time">{{item.fmtTime}}</text>
          <view wx:if="{{item.imgUrls.length > 0}}" class="req-imgs">
            <image wx:for="{{item.imgUrls}}" wx:key="*this" src="{{item}}" mode="aspectFit" class="req-img" bindtap="onPreviewImg" data-src="{{item}}" />
          </view>
          <view class="req-actions">
            <button class="btn-reject" data-id="{{item._id}}" bindtap="onReject">拒绝</button>
            <button class="btn-approve" data-id="{{item._id}}" bindtap="onApprove">通过</button>
          </view>
        </view>
      </block>
      <view wx:if="{{hasMorePending}}" class="load-more" bindtap="loadMorePending"><text>查看更多</text></view>
    </block>

    <!-- 已审核 -->
    <block wx:if="{{reviewSub === 'done'}}">
      <!-- 已审核积分 -->
      <view wx:if="{{reviewedList.length === 0}}" class="empty-tight"><text>暂无已审核积分</text></view>
      <block wx:for="{{reviewedList}}" wx:key="_id">
        <view class="card review-card">
          <view class="req-header">
            <text class="req-name">{{item.userName}}</text>
            <text class="tag tag-green" wx:if="{{item.status === 'approved'}}">已通过</text>
            <text class="tag tag-red" wx:else>已拒绝</text>
          </view>
          <text class="req-cat">{{item.category}} {{item.fmtPoints}}分</text>
          <text class="req-desc">{{item.description || '无说明'}}</text>
          <text class="req-id">单号 {{item.fmtId}}</text>
          <text class="req-time">{{item.fmtTime}}</text>
          <view wx:if="{{item.imgUrls.length > 0}}" class="req-imgs">
            <image wx:for="{{item.imgUrls}}" wx:key="*this" src="{{item}}" mode="aspectFit" class="req-img" bindtap="onPreviewImg" data-src="{{item}}" />
          </view>
        </view>
      </block>
      <view wx:if="{{hasMoreReviewed}}" class="load-more" bindtap="loadMoreReviewed"><text>查看更多</text></view>
    </block>
  </block>

  <!-- 录入/扣减 -->
  <block wx:if="{{tab === 'record'}}">
    <view wx:if="{{!isAdmin}}" class="empty-state">
      <text>仅管理员可操作</text>
    </view>
    <view wx:else class="card">
      <view class="form-group">
        <text class="form-label">积分数量（正=加，负=扣）</text>
        <input class="form-input" type="text" placeholder="正数=加分(填3)，负=扣分(填-3)" bindinput="onPointsInput" bindblur="onPointsBlur" />
      </view>
      <view class="form-group">
        <text class="form-label">选择用户</text>
        <view class="form-input user-trigger" wx:if="{{selectedCount === 0}}" bindtap="showUserPicker">
          <text class="placeholder">点击选择用户</text>
        </view>
        <view class="form-input user-trigger selected-box" wx:else bindtap="showUserPicker">
          <text class="selected-names" wx:if="{{!showAllNames}}">{{selectedNamesText}}</text>
          <text class="selected-names" wx:else>{{selectedNamesAll}}</text>
          <text wx:if="{{selectedNamesMore && !showAllNames}}" class="selected-more" catchtap="onToggleShowAll">展开</text>
          <text wx:if="{{showAllNames}}" class="selected-more" catchtap="onToggleShowAll">收起</text>
        </view>
        <text class="form-tip" wx:if="{{selectedCount > 0}}">已选 {{selectedCount}} 人，括号内为用户当前积分，扣减不能超过余额</text>
      </view>
      <view class="form-group">
        <text class="form-label">上传图片</text>
        <view class="img-grid">
          <block wx:for="{{deductImages}}" wx:key="index">
            <view class="img-item">
              <image class="img-pic" src="{{item}}" mode="aspectFill" />
              <text class="img-remove" data-idx="{{index}}" bindtap="onRemoveDeductImage">✕</text>
            </view>
          </block>
          <view wx:if="{{deductImages.length < 4}}" class="img-item img-add" bindtap="onChooseDeductImage">
            <text>+</text>
          </view>
        </view>
      </view>

      <view class="form-group">
        <text class="form-label">原因/说明</text>
        <input class="form-input" placeholder="如：周末LSD集体训练" value="{{deductReason}}" bindinput="onReasonInput" />
      </view>
      <button class="btn-primary" bindtap="onSubmitDeduct">确认提交</button>
    </view>

    <!-- 用户选择器 -->
    <view class="modal-mask" wx:if="{{showUserPicker}}" catchtap="hideUserPicker"></view>
    <view class="modal-box" wx:if="{{showUserPicker}}">
      <text class="modal-title">选择用户</text>
      <input class="form-input" placeholder="搜索昵称" value="{{userFilter}}" bindinput="onSearchUser" focus />
        <scroll-view scroll-y class="user-list">
        <block wx:for="{{filteredUsers}}" wx:key="_id">
          <view class="picker-item" data-id="{{item._id}}" data-name="{{item.nickName}}" bindtap="onSelectUser">
            <text class="picker-check">{{selectedUserIds[item._id] ? '☑' : '☐'}}</text>
            <text class="picker-name">{{item.nickName}}（{{item.city || '未知'}}）</text>
            <text class="picker-balance">{{item.balanceText}}</text>
          </view>
        </block>
      </scroll-view>
      <button class="btn-outline" bindtap="hideUserPicker" style="margin-top:24rpx;">取消</button>
    </view>
  </block>
</view>
