/* pages/tools/raceHelp/index.wxss */
.page { min-height: 100vh; background: #f5f6f8; padding-bottom: 40rpx; }

/* 顶部 */
.hd { display: flex; align-items: flex-start; justify-content: space-between; padding: 28rpx 28rpx 20rpx; background: #fff; }
.hd-main { flex: 1; min-width: 0; }
.hd-title { display: block; font-size: 38rpx; font-weight: 600; color: #1f1f1f; }
.hd-desc { display: block; font-size: 22rpx; color: #9aa5b1; margin-top: 8rpx; line-height: 1.5; }
.hd-add { flex-shrink: 0; margin-left: 20rpx; font-size: 26rpx; color: #1aad19; border: 2rpx solid #1aad19; border-radius: 24rpx; padding: 10rpx 22rpx; }

/* tab */
.tabs { display: flex; background: #fff; padding: 0 28rpx; border-bottom: 1rpx solid #eee; }
.tab { font-size: 28rpx; color: #666; padding: 22rpx 0; margin-right: 48rpx; position: relative; }
.tab.on { color: #1aad19; font-weight: 600; }
.tab.on::after { content: ''; position: absolute; left: 50%; bottom: 0; width: 44rpx; height: 6rpx; margin-left: -22rpx; background: #1aad19; border-radius: 3rpx; }
.tab-n { font-size: 22rpx; color: #bbb; margin-left: 8rpx; }
.tab.on .tab-n { color: #1aad19; }

/* 空态 */
.empty { padding: 120rpx 60rpx; text-align: center; }
.empty-t { display: block; font-size: 30rpx; color: #333; font-weight: 500; }
.empty-d { display: block; font-size: 24rpx; color: #9aa5b1; margin-top: 16rpx; line-height: 1.6; }
.empty-btn { display: inline-block; margin-top: 32rpx; font-size: 26rpx; color: #fff; background: #1aad19; border-radius: 30rpx; padding: 14rpx 44rpx; }

/* 赛事分组 */
.group { margin-top: 20rpx; }
.group-hd { display: flex; align-items: center; padding: 0 28rpx 12rpx; }
.group-name { font-size: 24rpx; color: #666; font-weight: 500; flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.group-date { font-size: 22rpx; color: #b0b8c1; margin-left: 12rpx; }

/* 条目 */
.item { background: #fff; margin: 0 20rpx 16rpx; border-radius: 16rpx; padding: 22rpx 24rpx; box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.03); }
.item-hd { display: flex; align-items: flex-start; justify-content: space-between; }
.item-title { flex: 1; font-size: 28rpx; color: #1f1f1f; font-weight: 500; line-height: 1.5; padding-right: 16rpx; }
.state { flex-shrink: 0; font-size: 20rpx; padding: 4rpx 14rpx; border-radius: 6rpx; }
.state.open { color: #1aad19; background: rgba(26,173,25,0.1); }
.state.expired { color: #fa8c16; background: rgba(250,140,22,0.1); }
.state.done { color: #1677ff; background: rgba(22,119,255,0.1); }
.state.canceled { color: #999; background: #f0f1f3; }
.state.banned { color: #ff4d4f; background: rgba(255,77,79,0.1); }

.item-meta { display: flex; flex-wrap: wrap; margin-top: 12rpx; }
.meta { font-size: 22rpx; color: #8a949e; margin-right: 20rpx; line-height: 1.6; }

.ap-row { display: flex; flex-wrap: wrap; align-items: center; margin-top: 12rpx; }
.ap-label { font-size: 22rpx; color: #b0b8c1; margin-right: 12rpx; }
.ap-chip { font-size: 22rpx; color: #1aad19; background: rgba(26,173,25,0.08); border-radius: 6rpx; padding: 4rpx 12rpx; margin: 0 10rpx 8rpx 0; }

.btns { display: flex; justify-content: flex-end; align-items: center; margin-top: 16rpx; }
.btn { font-size: 23rpx; color: #666; border: 2rpx solid #e2e5e9; border-radius: 20rpx; padding: 6rpx 22rpx; background: #fff; line-height: 1.5; margin: 0 0 0 14rpx; }
.btn::after { border: none; }
.btn-share { color: #1aad19; border-color: rgba(26,173,25,0.4); }
.btn-del { color: #ff4d4f; border-color: rgba(255,77,79,0.35); }

.foot-tip { padding: 32rpx 44rpx 0; font-size: 21rpx; color: #c2c8cf; text-align: center; line-height: 1.7; }

/* 弹层 */
.mask { position: fixed; left: 0; top: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.45); z-index: 100; }
.sheet { position: fixed; left: 0; right: 0; bottom: 0; z-index: 101; background: #fff; border-radius: 24rpx 24rpx 0 0; max-height: 70vh; display: flex; flex-direction: column; }
.sheet.tall { max-height: 88vh; }
.sheet-hd { display: flex; align-items: center; justify-content: space-between; padding: 26rpx 28rpx 16rpx; }
.sheet-title { font-size: 30rpx; font-weight: 600; color: #1f1f1f; }
.sheet-close { font-size: 30rpx; color: #bbb; padding: 0 10rpx; }

/* 选赛事 */
.ev-body { padding: 0 20rpx 20rpx; }
.ev { padding: 22rpx 20rpx; border-bottom: 1rpx solid #f2f3f5; }
.ev:last-child { border-bottom: none; }
.ev-name { display: block; font-size: 27rpx; color: #1f1f1f; }
.ev-meta { display: block; font-size: 22rpx; color: #9aa5b1; margin-top: 6rpx; }
.ev-foot { text-align: center; font-size: 25rpx; color: #1aad19; padding: 24rpx 0 36rpx; border-top: 1rpx solid #f2f3f5; }

/* 表单 */
.ev-bar { margin: 0 28rpx 4rpx; padding: 12rpx 18rpx; background: #f7f8fa; border-radius: 10rpx; font-size: 23rpx; color: #666; }
.form-body { padding: 8rpx 28rpx 20rpx; }
.lbl { display: block; font-size: 23rpx; color: #8a949e; margin: 20rpx 0 10rpx; }
.types { display: flex; flex-wrap: wrap; }
.type { font-size: 24rpx; color: #666; border: 2rpx solid #e5e8eb; border-radius: 10rpx; padding: 10rpx 20rpx; margin: 0 14rpx 12rpx 0; }
.type.on { color: #1aad19; border-color: #1aad19; background: rgba(26,173,25,0.06); }

.inp { width: 100%; box-sizing: border-box; font-size: 26rpx; color: #1f1f1f; background: #f7f8fa; border-radius: 10rpx; padding: 16rpx 18rpx; }
.area { height: 130rpx; line-height: 1.5; }
.picker { color: #1f1f1f; }
.row2 { display: flex; justify-content: space-between; }
.col { width: 48%; }

.agree { display: flex; align-items: flex-start; margin-top: 28rpx; }
.cb { flex-shrink: 0; width: 30rpx; height: 30rpx; line-height: 30rpx; text-align: center; font-size: 20rpx; color: #fff; border: 2rpx solid #d0d4d9; border-radius: 6rpx; margin-right: 12rpx; margin-top: 2rpx; }
.cb.on { background: #1aad19; border-color: #1aad19; }
.agree-t { flex: 1; font-size: 22rpx; color: #9aa5b1; line-height: 1.5; }

.form-ft { display: flex; padding: 16rpx 28rpx 34rpx; border-top: 1rpx solid #f2f3f5; }
.btn-outline { flex: 1; margin-right: 16rpx; font-size: 27rpx; color: #666; background: #fff; border: 2rpx solid #e2e5e9; border-radius: 40rpx; line-height: 2.6; }
.btn-primary { flex: 2; font-size: 27rpx; color: #fff; background: #1aad19; border-radius: 40rpx; line-height: 2.6; }
.btn-primary.dis { opacity: 0.6; }
