<!-- pages/tools/calendar/detail.wxml -->
<view class="detail-page">
  <!-- 基本信息 -->
  <view class="card">
    <view wx:if="{{event._posters && event._posters.length}}" class="dtl-poster-grid count-{{event._posters.length === 1 ? 1 : (event._posters.length === 2 || event._posters.length === 4 ? 2 : 3)}}">
      <view class="dtl-poster-item {{event._posters.length === 1 ? 'single' : ''}} {{event._posters.length === 2 ? 'two' : ''}}" wx:for="{{event._posters}}" wx:key="*this" wx:for-index="idx" catchtap="onPreviewPoster" data-idx="{{idx}}">
        <image src="{{item}}" mode="{{event._posters.length === 1 ? 'widthFix' : 'aspectFill'}}" class="dtl-poster-img {{event._posters.length === 1 ? 'single' : ''}}" />
      </view>
    </view>
    <image wx:elif="{{event.poster}}" src="{{event.poster}}" mode="widthFix" class="poster-img" />
    <view class="header-row">
      <text class="event-name">{{event.name}}</text>
      <text class="countdown">{{event.countdown}}</text>
    </view>
    <view class="dtl-meta">
      <text class="dtl-meta-item">{{event.city ? event.city + ' · ' : ''}}{{event.raceTypeName}}<text wx:if="{{event.raceLevel}}"> · {{event.raceLevel}}级</text></text>
    </view>
    <view class="badge-row" wx:if="{{event.label}}">
      <text class="badge badge-label {{event.label === '白金标' ? 'lb-baijin' : event.label === '金标' ? 'lb-jin' : event.label === '精英标' ? 'lb-jingying' : 'lb-putong'}}">{{event.label}}</text>
    </view>
    <view wx:if="{{event._scaleDisplay}}" class="dtl-meta">
      <text class="dtl-meta-label">规模</text>
      <text class="dtl-meta-value">{{event._scaleDisplay}}</text>
    </view>
    <view wx:if="{{event._feeDisplay || event.mechanism}}" class="dtl-meta">
      <text class="dtl-meta-label">费用</text>
      <text class="dtl-meta-value">{{event._feeDisplay}}{{event._feeDisplay && event.mechanism ? ' · ' : ''}}{{event.mechanism || ''}}{{event.payment ? ' · ' + event.payment : ''}}</text>
    </view>
    <view wx:if="{{event.website}}" class="dtl-meta link" bindtap="onWebsite">
      <text class="dtl-meta-label">官网</text>
      <text class="dtl-meta-link">{{event.website}}</text>
    </view>

  </view>

  <!-- 赛事信息（表格字段） -->
  <view class="card" wx:if="{{event.organizer || event.operator || event.regStatus || event.startPoint || event.signupChannels || event.medicalReport || event.finishRequirement || event.refundRule || event.contactPhone || event.contactEmail || event.wechatAccount || event.medalImage || event.routeMap}}">
    <view class="section-title"><text>🏅 赛事信息</text></view>
    <view wx:if="{{event.regStatus}}" class="dtl-meta"><text class="dtl-meta-label">报名状态</text><text class="dtl-meta-value">{{event.regStatus}}</text></view>
    <view wx:if="{{event.organizer}}" class="dtl-meta"><text class="dtl-meta-label">主办单位</text><text class="dtl-meta-value">{{event.organizer}}</text></view>
    <view wx:if="{{event.operator}}" class="dtl-meta"><text class="dtl-meta-label">运营单位</text><text class="dtl-meta-value">{{event.operator}}</text></view>
    <view wx:if="{{event.startPoint}}" class="dtl-meta"><text class="dtl-meta-label">起点</text><text class="dtl-meta-value">{{event.startPoint}}</text></view>
    <view wx:if="{{event.signupChannels}}" class="dtl-meta"><text class="dtl-meta-label">报名渠道</text><text class="dtl-meta-value">{{event.signupChannels}}</text></view>
    <view wx:if="{{event.medicalReport}}" class="dtl-meta"><text class="dtl-meta-label">体检报告</text><text class="dtl-meta-value">{{event.medicalReport}}</text></view>
    <view wx:if="{{event.finishRequirement}}" class="dtl-meta"><text class="dtl-meta-label">完赛经历</text><text class="dtl-meta-value">{{event.finishRequirement}}</text></view>
    <view wx:if="{{event.refundRule}}" class="dtl-meta"><text class="dtl-meta-label">退出机制</text><text class="dtl-meta-value">{{event.refundRule}}</text></view>
    <view wx:if="{{event.contactPhone}}" class="dtl-meta"><text class="dtl-meta-label">联系电话</text><text class="dtl-meta-value">{{event.contactPhone}}</text></view>
    <view wx:if="{{event.contactEmail}}" class="dtl-meta"><text class="dtl-meta-label">官方邮箱</text><text class="dtl-meta-value">{{event.contactEmail}}</text></view>
    <view wx:if="{{event.wechatAccount}}" class="dtl-meta"><text class="dtl-meta-label">公众号</text><text class="dtl-meta-value">{{event.wechatAccount}}</text></view>
    <image wx:if="{{event.medalImage}}" src="{{event.medalImage}}" mode="widthFix" class="poster-img" />
    <image wx:if="{{event.routeMap}}" src="{{event.routeMap}}" mode="widthFix" class="poster-img" />
  </view>
  <!-- 时间轴 -->
  <view class="card" wx:if="{{event.timeline && event.timeline.length > 0}}">
    <view class="section-title"><text>⏱ 赛事时间轴</text></view>
      <view class="tl-item {{t.status}}" wx:for="{{event.timeline}}" wx:key="label" wx:for-item="t" wx:if="{{index < 5 || showAllTimeline}}">
        <view class="tl-dot">
          <text wx:if="{{t.status === 'past'}}">🚩</text>
          <view wx:elif="{{t.status === 'next'}}" class="tl-flag"></view>
          <view wx:else class="tl-gray-dot"></view>
        </view>
        <view class="tl-body">
          <text class="tl-label">{{t.label}}</text>
          <text class="tl-date" wx:if="{{t.fmtDate}}">{{t.fmtDate}}</text>
          <!-- 发枪分区 -->
          <view wx:if="{{t.label === '鸣枪开跑' && event.gunTimes && event.gunTimes.length}}" class="gun-subs">
            <text class="gun-sub" wx:for="{{event.gunTimes}}" wx:key="index" wx:for-item="g">{{g.zone}}区 {{g.time}}</text>
          </view>
        </view>
      </view>
      <view wx:if="{{event.timeline && event.timeline.length > 5}}" class="tl-toggle" bindtap="onToggleTimeline">
        <text>{{showAllTimeline ? '收起时间轴 ▲' : '展开全部 (' + event.timeline.length + '项) ▼'}}</text>
      </view>
  </view>

  <!-- 评分概览 -->
  <view class="card" wx:if="{{reviewStats && reviewStats.count > 0}}">
    <view class="section-title"><text>赛事评分 ({{reviewStats.count}}人)</text></view>
    <!-- 类型Tab切换 -->
    <view class="score-tabs" wx:if="{{reviewStats.fullStats && reviewStats.halfStats}}">
      <text class="score-tab {{scoreTab === 'all' ? 'on' : ''}}" bindtap="onScoreTab" data-t="all">综合</text>
      <text class="score-tab {{scoreTab === 'full' ? 'on' : ''}}" bindtap="onScoreTab" data-t="full">全马</text>
      <text class="score-tab {{scoreTab === 'half' ? 'on' : ''}}" bindtap="onScoreTab" data-t="half">半马</text>
    </view>
    <!-- 全马/半马并排 -->
    <view class="type-scores" wx:if="{{scoreTab === 'all' && (reviewStats.fullStats || reviewStats.halfStats)}}">
      <view class="type-score-item" wx:if="{{reviewStats.fullStats}}">
        <text class="type-label">🏃 全马</text>
        <text class="type-num">{{reviewStats.fullStats.avgScore}}</text>
        <text class="type-count">{{reviewStats.fullStats.count}}人</text>
      </view>
      <view class="type-score-item" wx:if="{{reviewStats.halfStats}}">
        <text class="type-label">🏃 半马</text>
        <text class="type-num">{{reviewStats.halfStats.avgScore}}</text>
        <text class="type-count">{{reviewStats.halfStats.count}}人</text>
      </view>
    </view>
    <!-- 综合 -->
    <view class="overall-score" style="margin-top:12rpx;">
      <text class="score-num">{{reviewStats.avgScore}}</text>
      <text class="score-label">综合</text>
    </view>
    <view class="dim-scores">
        <view class="dim-row">
          <text class="dim-name">赛道</text>
          <view class="dim-bar-wrap"><view class="dim-bar" style="width:{{(reviewStats.dimensions.difficulty||0)*10}}%"></view></view>
          <text class="dim-val">{{reviewStats.dimensions.difficulty || 0}}</text>
        </view>
        <view class="dim-row">
          <text class="dim-name">氛围</text>
          <view class="dim-bar-wrap"><view class="dim-bar" style="width:{{(reviewStats.dimensions.atmosphere||0)*10}}%"></view></view>
          <text class="dim-val">{{reviewStats.dimensions.atmosphere || 0}}</text>
        </view>
        <view class="dim-row">
          <text class="dim-name">补给</text>
          <view class="dim-bar-wrap"><view class="dim-bar" style="width:{{(reviewStats.dimensions.supply||0)*10}}%"></view></view>
          <text class="dim-val">{{reviewStats.dimensions.supply || 0}}</text>
        </view>
        <view class="dim-row">
          <text class="dim-name">交通</text>
          <view class="dim-bar-wrap"><view class="dim-bar" style="width:{{(reviewStats.dimensions.transport||0)*10}}%"></view></view>
          <text class="dim-val">{{reviewStats.dimensions.transport || 0}}</text>
        </view>
      </view>
  </view>
  <view class="card" wx:else>
    <text class="no-score">暂无评分</text>
  </view>

  <!-- 跑友评价总结 -->
  <view class="card" wx:if="{{event.aiSummary}}">
    <view class="section-title"><text>📊 赛事总评</text></view>
    <text class="summary-text">{{event.aiSummary}}</text>
  </view>

  <!-- 热门标签 -->
  <view class="card" wx:if="{{topTags.length > 0}}">
    <view class="section-title"><text>🏷 热门标签</text></view>
    <view class="tag-list">
      <view class="tag-item" wx:for="{{topTags}}" wx:key="0" wx:for-item="t">
        <text class="tag-name">{{t[0]}}</text>
        <text class="tag-count">×{{t[1]}}</text>
      </view>
    </view>
  </view>

  <!-- 我的评价 -->
  <view class="card" wx:if="{{myReview._id}}">
    <view class="section-title">
      <text>📝 我的评价</text>
      <view style="display:flex;gap:12rpx;">
        <text class="del-review-btn" bindtap="onReview">✏️ 编辑</text>
        <text class="del-review-btn" catchtap="onDelMyReview" data-id="{{myReview._id}}">🗑 删除</text>
      </view>
    </view>
    <view class="my-review">
      <text class="my-section-label">⭐ 评分（{{myReview.myAvg}}）</text>
      <view class="my-dim-list">
        <text class="my-dim">赛道 {{myReview.scores.difficulty}}</text>
        <text class="my-dim">氛围 {{myReview.scores.atmosphere}}</text>
        <text class="my-dim">补给 {{myReview.scores.supply}}</text>
        <text class="my-dim">交通 {{myReview.scores.transport}}</text>
      </view>
      <view wx:if="{{myReviewTags}}">
        <text class="my-section-label">🏷 标签</text>
        <text class="my-tags-text">{{myReviewTags}}</text>
      </view>
      <view wx:if="{{myReview.description}}">
        <text class="my-section-label">💬 感受</text>
        <view class="my-desc">
          <text>{{myReview.description}}</text>
        </view>
      </view>
      <view wx:if="{{event.timeline && event.timeline.length > 5}}" class="tl-toggle" bindtap="onToggleTimeline">
        <text>{{showAllTimeline ? '收起时间轴 ▲' : '展开全部 (' + event.timeline.length + '项) ▼'}}</text>
      </view>
    </view>
  </view>

  <!-- 他人评价 -->
  <view class="card" wx:if="{{otherReviews.length > 0}}">
    <view class="section-title">
      <text>💬 跑友评价 ({{reviewTotal}}条)</text>
      <view class="review-type-filter" wx:if="{{reviewStats.fullStats || reviewStats.halfStats}}">
        <text class="filter-chip {{reviewTypeFilter === '' ? 'on' : ''}}" bindtap="onReviewTypeFilter" data-v="">全部</text>
        <text class="filter-chip {{reviewTypeFilter === 'full' ? 'on' : ''}}" bindtap="onReviewTypeFilter" data-v="full">全马</text>
        <text class="filter-chip {{reviewTypeFilter === 'half' ? 'on' : ''}}" bindtap="onReviewTypeFilter" data-v="half">半马</text>
      </view>
    </view>
    <view class="other-review" wx:for="{{otherReviews}}" wx:key="_id" wx:if="{{!reviewTypeFilter || item.raceType === reviewTypeFilter}}">
      <view class="or-header">
        <text class="or-user">{{item.userName}}</text>
        <text class="or-info">{{item.year}}年{{item.raceTypeName}}</text>
      </view>
      <text class="my-section-label">⭐ 评分（{{item.myAvg}}）</text>
      <view class="my-dim-list">
        <text class="my-dim">赛道 {{item.scores.difficulty}}</text>
        <text class="my-dim">氛围 {{item.scores.atmosphere}}</text>
        <text class="my-dim">补给 {{item.scores.supply}}</text>
        <text class="my-dim">交通 {{item.scores.transport}}</text>
      </view>
      <view wx:if="{{item.tags && item.tags.length}}">
        <text class="my-section-label">🏷 标签</text>
        <text class="my-tags-text">{{item.tagStr}}</text>
      </view>
      <view wx:if="{{item.description}}">
        <text class="my-section-label">💬 感受</text>
        <view class="my-desc"><text>{{item.description}}</text></view>
      </view>
    </view>
    <view wx:if="{{reviewHasMore}}" class="load-more" bindtap="loadMoreReviews">
      <text>查看更多</text>
    </view>
  </view>

  <!-- 我的状态 & 操作按钮 -->
  <view class="card" wx:if="{{isMine}}">
    <view class="section-title"><text>📌 我的状态</text></view>
    <view class="mark-row">
      <text>{{myStatus === 'planned' ? '📋 计划报名' : myStatus === 'registered' ? '✅ 已报名' : myStatus === 'won' ? '🎉 已中签' : myStatus === 'lost' ? '❌ 未中签' : myStatus === 'finished' ? '🏁 已完赛' : myStatus === 'dnf' ? '💔 未完赛' : myStatus === 'dns' ? '🚫 弃赛' : '未关注'}}</text>
      <text class="act" catchtap="onMark">修改</text>
    </view>
  </view>
  <view class="card" wx:elif="{{!isMine}}">
    <view class="btn-primary" catchtap="onMark" hover-class="btn-hover">⭐ 关注赛事</view>
  </view>

  <!-- 群二维码展示（管理员已上传时）。赛事已经跑完就整个不展示，那时的群码没有意义 -->
  <view class="card qr-show" wx:if="{{!raceFinished && qrStatus !== 'none' && qrCodeUrl}}">
    <view class="section-title">
      <text>{{qrStatus === 'expired' ? '👥 赛事交流群（二维码已过期）' : '👥 赛事交流群'}}</text>
    </view>
    <view class="qr-show-box">
      <image src="{{qrCodeUrl}}" mode="aspectFit" class="qr-show-img" bindtap="onPreviewRaceQr" />
      <text wx:if="{{qrStatus === 'expired'}}" class="qr-show-warn">⚠️ 二维码已过期，扫码可能无法进群</text>
      <text wx:else class="qr-show-tip">点击二维码可放大保存</text>
    </view>
  </view>

  <!-- 没上传二维码：通知上传（3 人即达标，进度与名单可见） -->
  <view class="card qr-notice" wx:if="{{!raceFinished && qrStatus === 'none'}}">
    <view class="section-title">
      <text>📭 该赛事还没建群</text>
    </view>

    <!-- 催办进度：给管理员看的人数参考，满 3 人 100% -->
    <view class="qr-progress">
      <view class="qr-progress-head">
        <text class="qr-progress-num">{{remindCount}}<text class="qr-progress-total">/{{remindTarget}} 人已催</text></text>
        <text class="qr-progress-hint {{remindDone ? 'done' : ''}}">{{remindDone ? '满 3 人，负责人会优先建群' : (remindCount > 0 ? ('还差 ' + (remindTarget - remindCount) + ' 人到 3 人') : '还没人催，做第一个')}}</text>
      </view>
      <view class="qr-bar-wrap">
        <view class="qr-bar {{remindDone ? 'done' : ''}}" style="width:{{remindPercent}}%"></view>
      </view>
      <view class="qr-avatars" wx:if="{{remindList.length}}">
        <view class="qr-avatar" wx:for="{{remindList}}" wx:key="userId">
          <image wx:if="{{item.avatarUrl}}" class="qr-avatar-img" src="{{item.avatarUrl}}" mode="aspectFill" />
          <view wx:else class="qr-avatar-img qr-avatar-fb">🏃</view>
          <text class="qr-avatar-name">{{item.isMe ? '我' : item.nickName}}</text>
        </view>
      </view>
    </view>

    <view class="qr-notice-btn {{notifyingOwner || cooldownLeft > 0 ? 'disabled' : ''}}" catchtap="onNotifyOwner">
      <text>{{notifyingOwner ? '催办中…' : (cooldownText ? ('已催过，' + cooldownText) : (myReminded ? '🔔 再催一次' : '🔔 催管理员建群'))}}</text>
    </view>
    <button class="qr-share-btn" open-type="share">💬 拉同场跑友一起催</button>
    <text class="qr-notice-foot">{{remindDone ? '负责人已收到提醒，会优先处理；也可以先把链接发给同场跑友' : '点一下就通知到负责人，不用凑人；攒到 3 人负责人会优先建群，不满 3 人他可以先不建'}}</text>
  </view>

  <!-- 已有二维码但过期了：直接提醒管理员更新（不展示进度，每天 10 点也会自动提醒一次） -->
  <view class="card qr-notice" wx:elif="{{!raceFinished && qrStatus === 'expired'}}">
    <view class="section-title">
      <text>⚠️ 群二维码已过期</text>
    </view>
    <text class="qr-notice-desc">微信的群二维码只有 7 天有效期，过期了就扫不进去。点下面提醒管理员换一张新的。</text>

    <view class="qr-notice-btn {{notifyingOwner || cooldownLeft > 0 ? 'disabled' : ''}}" catchtap="onNotifyOwner">
      <text>{{notifyingOwner ? '提醒中…' : (cooldownText ? ('已提醒，' + cooldownText) : (myReminded ? '🔔 再提醒一次' : '🔔 提醒管理员更新'))}}</text>
    </view>
    <text class="qr-notice-foot">除你手动提醒外，系统每天 10 点也会自动提醒管理员一次</text>
  </view>

  <!-- ===== 跑友互助：只有关注了这场赛事的跑友才看得到 ===== -->
  <view class="card help-card" wx:if="{{!raceFinished}}">
    <view class="section-title help-title">
      <text>🙌 跑友互助</text>
      <view class="help-head-actions">
        <text class="help-mine-link" catchtap="onOpenMyHelp">我的互助</text>
        <text class="help-add {{isMine ? '' : 'disabled'}}" catchtap="onOpenHelpForm">＋ 发布</text>
      </view>
    </view>

    <!-- 没关注这场赛事：不给看也不给发 -->
    <view class="help-locked" wx:if="{{!isMine}}">
      <text>拼房 / 拼车 / 约饭是跑友之间的自发互助。关注这场赛事后，才能看到别人发布的互助，也可以自己发布。</text>
    </view>

    <block wx:else>
      <view class="help-empty" wx:if="{{!helpLoading && helpList.length === 0}}">
        <text>还没有跑友发布互助，做第一个吧</text>
      </view>

      <view class="help-item" wx:for="{{helpList}}" wx:key="_id" data-id="{{item._id}}" catchtap="onOpenHelpDetail">
        <view class="help-item-head">
          <text class="help-item-icon">{{item.typeIcon}}</text>
          <text class="help-item-title">{{item.title}}</text>
          <text class="help-item-tag">{{item.typeLabel}}</text>
        </view>
        <text class="help-item-desc" wx:if="{{item.desc}}">{{item.desc}}</text>
        <view class="help-item-foot">
          <text class="help-item-cost" wx:if="{{item.costNote}}">💰 {{item.costNote}}</text>
          <text class="help-item-people">缺 {{item.peopleNeeded}} 人</text>
          <text class="help-item-left {{item.daysLeft <= 3 ? 'urgent' : ''}}">{{item.daysLeft === 0 ? '今天截止' : '剩 ' + item.daysLeft + ' 天'}}</text>
          <text class="help-item-apply" wx:if="{{item.applyCount}}">{{item.applyCount}} 人应征</text>
        </view>
      </view>

      <text class="help-disclaimer">信息由跑友自发发布，平台不收费、不审核真实性、不参与协调</text>
    </block>
  </view>

  <!-- 自定义关注操作面板 -->
  <view class="action-sheet-mask" wx:if="{{showMarkSheet}}" catchtap="onHideMarkSheet"></view>
  <view class="action-sheet" wx:if="{{showMarkSheet}}">
    <view class="action-sheet-title">关注赛事</view>
    <view class="action-sheet-item" catchtap="onMarkSelect" data-status="planned">📋 计划报名</view>
    <view class="action-sheet-item" catchtap="onMarkSelect" data-status="registered">✅ 已报名</view>
    <view class="action-sheet-item" catchtap="onMarkSelect" data-status="won">🎉 已中签</view>
    <view class="action-sheet-item" catchtap="onMarkSelect" data-status="lost">❌ 未中签</view>
    <view class="action-sheet-item" catchtap="onMarkSelect" data-status="finished">🏁 已完赛</view>
    <view class="action-sheet-item" catchtap="onMarkSelect" data-status="dnf">💔 未完赛</view>
    <view class="action-sheet-item" catchtap="onMarkSelect" data-status="dns">🚫 弃赛</view>
    <view class="action-sheet-cancel" catchtap="onHideMarkSheet">取消</view>
  </view>
  <view class="btn-area">
    <button wx:if="{{myReview._id}}" class="btn-primary" catchtap="onReview">✏️ 修改评价</button>
    <button wx:elif="{{myStatus === 'finished'}}" class="btn-primary" catchtap="onReview">⭐ 参与评分</button>
    <button wx:elif="{{isMine}}" class="btn-primary disabled" disabled>需关注并标记"已完赛"后才可评分</button>
  </view>

  <!-- 完赛成绩录入弹窗 -->
  <view class="modal-mask" wx:if="{{showResultModal}}" catchtap="onCancelResult"></view>
  <view class="modal-box" wx:if="{{showResultModal}}">
    <view class="modal-header">
      <text>录入完赛成绩</text>
      <text class="modal-close" bindtap="onCancelResult">✕</text>
    </view>
    <text class="form-label">完赛成绩</text>
    <view class="form-input time-trigger" catchtap="onPickResultTime">
      <text class="{{resultInput ? '' : 'placeholder'}}">{{resultInput || '点此选择'}}</text>
      <text class="city-arrow">▾</text>
    </view>
    <view class="modal-actions" style="margin-top:32rpx;">
      <button class="btn-outline" catchtap="onCancelResult">取消</button>
      <button class="btn-primary" catchtap="onConfirmResult">确认</button>
    </view>
  </view>

  <time-picker value="{{resultInput}}" show="{{showResultTimePicker}}" label="完赛成绩" default-value="{{resultRaceType === '10k' ? '0:50:30' : resultRaceType === 'half' ? '2:00:00' : '3:30:00'}}" bind:confirm="onResultTimeChange" bind:cancel="onHideResultTime"></time-picker>

  <!-- 图片预览 -->
  <view class="poster-full" wx:if="{{showPoster && event._posters && event._posters.length}}">
    <view class="poster-full-top">
      <text class="poster-full-counter">{{posterIdx + 1}} / {{event._posters.length}}</text>
      <text class="poster-full-close" bindtap="onHidePoster">✕</text>
    </view>
    <swiper class="poster-full-swiper" current="{{posterIdx}}" bindchange="onPosterSwiperChange" duration="200">
      <swiper-item wx:for="{{event._posters}}" wx:key="*this">
        <image src="{{item}}" mode="aspectFit" class="poster-full-img" />
      </swiper-item>
    </swiper>
  </view>

  <!-- ===== 发布互助（规则必读 + 勾选才能发） ===== -->
  <view class="modal-mask" wx:if="{{showHelpForm}}" catchtap="onCloseHelpForm"></view>
  <view class="modal-box help-modal" wx:if="{{showHelpForm}}">
    <view class="modal-header">
      <text>发布互助</text>
      <text class="modal-close" catchtap="onCloseHelpForm">✕</text>
    </view>
    <scroll-view class="help-body" scroll-y>
      <text class="form-label">类型</text>
      <view class="help-types">
        <text class="help-type {{helpForm.type === item.key ? 'on' : ''}}" wx:for="{{helpTypes}}" wx:key="key" data-k="{{item.key}}" catchtap="onPickHelpType">{{item.icon}} {{item.label}}</text>
      </view>

      <text class="form-label">标题</text>
      <input class="form-input" placeholder="如：找个女生拼房" maxlength="20" value="{{helpForm.title}}" data-k="title" bindinput="onHelpFormInput" />

      <text class="form-label">说明（选填）</text>
      <textarea class="help-textarea" placeholder="酒店位置、出发时间等，最多 200 字" maxlength="200" value="{{helpForm.desc}}" data-k="desc" bindinput="onHelpFormInput" />

      <text class="form-label">费用说明（选填）</text>
      <input class="form-input" placeholder="如：AA，预计 200/晚" maxlength="30" value="{{helpForm.costNote}}" data-k="costNote" bindinput="onHelpFormInput" />

      <text class="form-label">还差几人</text>
      <input class="form-input" type="number" placeholder="1" value="{{helpForm.peopleNeeded}}" data-k="peopleNeeded" bindinput="onHelpFormInput" />

      <text class="form-label">截止时间</text>
      <picker mode="date" start="{{helpToday}}" end="{{helpMaxDate}}" value="{{helpForm.deadline}}" bindchange="onHelpDeadline">
        <view class="form-input help-date {{helpForm.deadline ? '' : 'placeholder'}}">{{helpForm.deadline || '选择日期'}}</view>
      </picker>

      <text class="form-label">我的联系方式（对方应征后才可见）</text>
      <input class="form-input" placeholder="微信号" maxlength="40" value="{{helpForm.wechat}}" data-k="wechat" bindinput="onHelpFormInput" />
      <input class="form-input" placeholder="手机号（选填）" maxlength="20" value="{{helpForm.phone}}" data-k="phone" bindinput="onHelpFormInput" />

      <view class="help-rule">
        <text class="help-rule-title">互助规则（请仔细阅读）</text>
        <text class="help-rule-text">1. 本条信息由你本人发布，平台仅提供展示位置，不参与撮合、不代收款项。
2. 平台不收取任何费用，也不承担线下接触产生的纠纷与责任。
3. 平台无法核实其他跑友的真实身份，约见请自行判断风险，建议在公共场所。
4. 不得发布任何涉交易、转卖、代购、名额转让的信息，发现即下架。
5. 到截止时间自动失效，你也可以随时关闭。</text>
      </view>

      <view class="help-agree" catchtap="onToggleHelpRule">
        <text class="help-checkbox {{helpForm.ruleAgreed ? 'on' : ''}}">{{helpForm.ruleAgreed ? '✓' : ''}}</text>
        <text class="help-agree-text">我已阅读并同意以上互助规则</text>
      </view>

      <view class="modal-actions">
        <button class="btn-outline" catchtap="onCloseHelpForm">取消</button>
        <button class="btn-primary {{helpSubmitting ? 'disabled' : ''}}" catchtap="onSubmitHelp">{{helpSubmitting ? '发布中…' : '发布'}}</button>
      </view>
    </scroll-view>
  </view>

  <!-- ===== 互助详情 / 应征 ===== -->
  <view class="modal-mask" wx:if="{{showHelpDetail}}" catchtap="onCloseHelpDetail"></view>
  <view class="modal-box help-modal" wx:if="{{showHelpDetail}}">
    <view class="modal-header">
      <text>互助详情</text>
      <text class="modal-close" catchtap="onCloseHelpDetail">✕</text>
    </view>
    <scroll-view class="help-body" scroll-y>
      <view class="help-d-title">{{curHelp.typeIcon}} {{curHelp.title}}</view>
      <view class="help-d-meta">
        <text>{{curHelp.typeLabel}}</text>
        <text>缺 {{curHelp.peopleNeeded}} 人</text>
        <text class="{{curHelp.daysLeft <= 3 ? 'urgent' : ''}}">{{curHelp.daysLeft === 0 ? '今天截止' : '剩 ' + curHelp.daysLeft + ' 天'}}</text>
      </view>
      <view class="help-d-row" wx:if="{{curHelp.costNote}}"><text class="help-d-k">费用</text><text>{{curHelp.costNote}}</text></view>
      <view class="help-d-row" wx:if="{{curHelp.desc}}"><text class="help-d-k">说明</text><text>{{curHelp.desc}}</text></view>
      <view class="help-d-owner">👤 {{curHelp.nickName}}　·　已有 {{curHelp.applyCount || 0}} 人应征</view>

      <block wx:if="{{curHelp.isMine}}">
        <text class="help-d-tip">这是你发布的互助，可在「我的互助」里查看应征的人或关闭它。</text>
        <view class="modal-actions">
          <button class="btn-primary" catchtap="onOpenMyHelp">查看应征的人</button>
        </view>
      </block>
      <block wx:else>
        <text class="help-d-tip">联系方式在双方应征后互相可见。平台不代为转达，也不参与你们的约定。</text>
        <text class="form-label">留言（选填）</text>
        <input class="form-input" placeholder="如：女生，想一起拼" maxlength="50" value="{{applyMessage}}" data-k="applyMessage" bindinput="onApplyInput" />
        <text class="form-label">我的联系方式（发布者会看到）</text>
        <input class="form-input" placeholder="微信号" maxlength="40" value="{{applyWechat}}" data-k="applyWechat" bindinput="onApplyInput" />
        <input class="form-input" placeholder="手机号（选填）" maxlength="20" value="{{applyPhone}}" data-k="applyPhone" bindinput="onApplyInput" />
        <view class="modal-actions">
          <button class="btn-outline" catchtap="onReportHelp">举报</button>
          <button class="btn-primary {{applying ? 'disabled' : ''}}" catchtap="onSubmitApply">{{applying ? '提交中…' : '我来应征'}}</button>
        </view>
      </block>
    </scroll-view>
  </view>

  <!-- ===== 我的互助 ===== -->
  <view class="modal-mask" wx:if="{{showHelpMine}}" catchtap="onCloseMyHelp"></view>
  <view class="modal-box help-modal" wx:if="{{showHelpMine}}">
    <view class="modal-header">
      <text>我的互助</text>
      <text class="modal-close" catchtap="onCloseMyHelp">✕</text>
    </view>
    <view class="help-tabs">
      <text class="help-tab {{helpMineTab === 'mine' ? 'on' : ''}}" data-t="mine" catchtap="onSwitchHelpTab">我发布的</text>
      <text class="help-tab {{helpMineTab === 'apply' ? 'on' : ''}}" data-t="apply" catchtap="onSwitchHelpTab">我应征的</text>
    </view>
    <scroll-view class="help-body" scroll-y>
      <block wx:if="{{helpMineTab === 'mine'}}">
        <view class="help-empty" wx:if="{{myHelps.length === 0}}"><text>还没有发布过互助</text></view>
        <view class="help-mine-item" wx:for="{{myHelps}}" wx:key="_id">
          <view class="help-mine-head">
            <text class="help-mine-title">{{item.typeIcon}} {{item.title}}</text>
            <text class="help-mine-status {{item.status === 'open' && !item.expired ? 'on' : ''}}">{{item.expired ? '已截止' : (item.status === 'open' ? '招募中' : '已关闭')}}</text>
          </view>
          <view class="help-mine-row" wx:if="{{item.applyCount}}">已有 {{item.applyCount}} 人应征</view>
          <view class="help-applicant" wx:for="{{item.applicants}}" wx:for-item="ap" wx:key="userId">
            <text class="help-ap-name">👤 {{ap.nickName}}</text>
            <text class="help-ap-msg" wx:if="{{ap.message}}">{{ap.message}}</text>
            <text class="help-ap-contact" wx:if="{{ap.contact.wechat}}">微信 {{ap.contact.wechat}}</text>
            <text class="help-ap-contact" wx:if="{{ap.contact.phone}}">手机 {{ap.contact.phone}}</text>
          </view>
          <view class="help-mine-btns" wx:if="{{item.status === 'open' && !item.expired}}">
            <text class="help-mine-btn" data-id="{{item._id}}" catchtap="onCloseHelpItem">关闭招募</text>
          </view>
        </view>
      </block>
      <block wx:else>
        <view class="help-empty" wx:if="{{myApplies.length === 0}}"><text>还没有应征过互助</text></view>
        <view class="help-mine-item" wx:for="{{myApplies}}" wx:key="applyId">
          <view class="help-mine-head">
            <text class="help-mine-title">{{item.typeIcon}} {{item.title}}</text>
          </view>
          <view class="help-mine-row" wx:if="{{item.costNote}}">💰 {{item.costNote}}</view>
          <view class="help-applicant">
            <text class="help-ap-name">👤 {{item.nickName}}（发布者）</text>
            <text class="help-ap-contact" wx:if="{{item.ownerContact.wechat}}">微信 {{item.ownerContact.wechat}}</text>
            <text class="help-ap-contact" wx:if="{{item.ownerContact.phone}}">手机 {{item.ownerContact.phone}}</text>
          </view>
          <view class="help-mine-btns">
            <text class="help-mine-btn" data-id="{{item.applyId}}" catchtap="onCancelMyApply">取消应征</text>
          </view>
        </view>
      </block>
    </scroll-view>
  </view>
</view>
