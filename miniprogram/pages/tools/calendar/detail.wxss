.detail-page { padding-bottom: 40rpx; }

/* 朋友圈式图片网格 */
.dtl-poster-grid {
  display: grid;
  gap: 8rpx;
  margin-bottom: 16rpx;
  border-radius: 12rpx;
  overflow: hidden;
}
.dtl-poster-grid.count-1 { grid-template-columns: 1fr; }
.dtl-poster-grid.count-2 { grid-template-columns: 1fr 1fr; }
.dtl-poster-grid.count-3 { grid-template-columns: 1fr 1fr 1fr; }
.dtl-poster-grid.count-4 { grid-template-columns: 1fr 1fr; }
.dtl-poster-item {
  aspect-ratio: 1;
  overflow: hidden;
  border-radius: 8rpx;
  background: #f5f5f5;
}
.dtl-poster-item.single {
  aspect-ratio: auto;
  max-height: 500rpx;
}
.dtl-poster-item.two {
  aspect-ratio: 1;
}
.dtl-poster-img {
  width: 100%;
  height: 100%;
}
.dtl-poster-img.single {
  height: auto;
}
.poster-img { width: 100%; border-radius: 12rpx; margin-bottom: 16rpx; }

/* 全屏预览 */
.poster-full { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: #000; z-index: 9999; display: flex; flex-direction: column; }
.poster-full-top { position: absolute; top: 0; left: 0; right: 0; display: flex; justify-content: space-between; align-items: center; padding: 60rpx 32rpx 0; z-index: 10; }
.poster-full-counter { color: rgba(255,255,255,0.8); font-size: 26rpx; }
.poster-full-close { color: #fff; font-size: 44rpx; line-height: 1; padding: 8rpx; }
.poster-full-swiper { flex: 1; width: 100%; }
.poster-full-img { width: 100%; height: 100%; display: block; }

.header-row { display: flex; justify-content: space-between; align-items: flex-start; }
.event-name { font-size: 34rpx; font-weight: 700; color: #333; flex: 1; }
.countdown { font-size: 28rpx; color: #ff6b00; font-weight: 600; white-space: nowrap; }

/* 详情元信息行，有值才展示，每行不超过两段 */
.dtl-meta { display: flex; align-items: baseline; gap: 12rpx; margin-top: 10rpx; font-size: 26rpx; line-height: 1.5; }
.dtl-meta-item { color: #999; }
.dtl-meta-label { color: #999; flex-shrink: 0; font-size: 24rpx; }
.dtl-meta-value { color: #666; flex: 1; }
.dtl-meta.link { margin-top: 12rpx; }
.dtl-meta-link { color: #1aad19; flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

.section-title { display: flex; justify-content: space-between; align-items: center; font-size: 30rpx; font-weight: 600; margin-bottom: 16rpx; }
.arrow { font-size: 36rpx; color: #ccc; }

.score-overview { display: flex; gap: 24rpx; }
.type-scores { display: flex; gap: 16rpx; }
.type-score-item { flex: 1; background: #f5f5f5; border-radius: 12rpx; padding: 16rpx; text-align: center; }
.type-label { font-size: 24rpx; color: #666; display: block; }
.type-num { font-size: 40rpx; font-weight: 700; color: #ff9800; display: block; margin: 4rpx 0; }
.type-count { font-size: 22rpx; color: #999; }

.score-tabs { display: flex; gap: 8rpx; margin-bottom: 12rpx; }
.score-tab { font-size: 24rpx; padding: 8rpx 20rpx; border-radius: 20rpx; background: #f5f5f5; color: #666; }
.score-tab.on { background: #e8f5e9; color: #1aad19; font-weight: 600; }

.review-type-filter { display: flex; gap: 6rpx; }
.review-type-filter .filter-chip { font-size: 20rpx; padding: 4rpx 12rpx; border-radius: 10rpx; background: #f5f5f5; color: #666; }
.review-type-filter .filter-chip.on { background: #e8f5e9; color: #1aad19; }
.overall-score { text-align: center; flex-shrink: 0; }
.score-num { font-size: 64rpx; font-weight: 700; color: #ff9800; display: block; }
.score-label { font-size: 22rpx; color: #999; display: block; margin-top: 4rpx; }
.score-count { font-size: 22rpx; color: #bbb; display: block; }

.dim-scores { flex: 1; display: flex; flex-direction: column; gap: 8rpx; }
.dim-row { display: flex; align-items: center; gap: 8rpx; }
.dim-name { font-size: 22rpx; color: #666; width: 80rpx; flex-shrink: 0; text-align: right; }
.dim-bar-wrap { flex: 1; height: 12rpx; background: #f0f0f0; border-radius: 6rpx; overflow: hidden; }
.dim-bar { height: 100%; background: linear-gradient(90deg, #ff9800, #ffc107); border-radius: 6rpx; }
.dim-val { font-size: 22rpx; color: #ff9800; font-weight: 600; width: 48rpx; }
.no-score { font-size: 26rpx; color: #bbb; text-align: center; display: block; padding: 24rpx 0; }
.summary-text { font-size: 26rpx; color: #444; line-height: 1.7; }

.tag-list { display: flex; flex-wrap: wrap; gap: 12rpx; }
.tag-item { display: flex; align-items: center; gap: 4rpx; padding: 8rpx 16rpx; border-radius: 20rpx; background: #f0f7ff; }
.tag-name { font-size: 24rpx; color: #1a73e8; }
.tag-count { font-size: 22rpx; color: #999; }

.btn-area { padding: 24rpx; display: flex; flex-direction: column; gap: 16rpx; }
.btn-primary.disabled { opacity: 0.5; background: #ccc; }

.my-review { padding: 8rpx 0; }
.my-scores { font-size: 24rpx; color: #333; }
.my-dim-list { display: flex; flex-wrap: wrap; gap: 6rpx; margin-top: 6rpx; }
.my-dim { font-size: 22rpx; color: #666; background: #f5f5f5; padding: 4rpx 10rpx; border-radius: 6rpx; }
.my-section-label { font-size: 26rpx; color: #333; font-weight: 600; display: block; margin-top: 16rpx; margin-bottom: 8rpx; }
.my-tags-text { font-size: 24rpx; color: #1aad19; }

.other-review { padding: 16rpx 0; border-bottom: 1rpx solid #f0f0f0; }
.other-review:last-child { border-bottom: none; }
.or-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 4rpx; }
.or-user { font-size: 26rpx; color: #333; font-weight: 500; }
.or-avg { font-size: 28rpx; color: #ff9800; font-weight: 700; }
.or-info { font-size: 22rpx; color: #999; }
.load-more { text-align: center; padding: 16rpx; font-size: 24rpx; color: #1aad19; }
.my-desc { font-size: 24rpx; color: #555; line-height: 1.6; background: #fafafa; padding: 12rpx; border-radius: 8rpx; }

.del-review-btn { font-size: 22rpx; color: #ff4d4f; padding: 4rpx 8rpx; }

.timeline { padding-left: 16rpx; }
.tl-item { display: flex; gap: 12rpx; padding: 12rpx 0; border-left: 3rpx solid #e0e0e0; padding-left: 20rpx; position: relative; }
.tl-item:last-child { border-left-color: transparent; }
.tl-dot { position: absolute; display: flex; align-items: center; justify-content: center; }
.tl-body { display: flex; flex-direction: column; }
.tl-label { font-size: 26rpx; color: #333; font-weight: 500; }
.tl-date { font-size: 24rpx; color: #999; margin-top: 2rpx; }

/* past: 已过节点 - 红旗 */
.tl-item.past .tl-dot { left: -12rpx; top: 14rpx; font-size: 24rpx; }
.tl-item.past .tl-dot text { line-height: 1; }

/* next: 下一个节点 - 绿色旗子, 放大 */
.tl-item.next { border-left-color: #1aad19; }
.tl-item.next .tl-dot { left: -17rpx; top: 12rpx; }
.tl-flag { width: 28rpx; height: 28rpx; background: #1aad19; border-radius: 50%; box-shadow: 0 0 0 4rpx rgba(26,173,25,0.2); }
.tl-item.next .tl-label { color: #1aad19; font-weight: 700; font-size: 28rpx; }
.tl-item.next .tl-date { color: #1aad19; }

/* future: 将来节点 - 灰色 */
.tl-item.future .tl-dot { left: -7rpx; top: 18rpx; }
.tl-gray-dot { width: 12rpx; height: 12rpx; background: #d0d0d0; border-radius: 50%; }
.tl-item.future .tl-label { color: #bbb; }
.tl-item.future .tl-date { color: #ccc; }

.gun-subs { margin-top: 8rpx; display: flex; flex-wrap: wrap; gap: 6rpx; }
.gun-sub { font-size: 20rpx; color: #888; background: #f5f5f5; padding: 4rpx 12rpx; border-radius: 8rpx; }

.mark-row { display: flex; align-items: center; justify-content: space-between; padding: 8rpx 0; font-size: 28rpx; }
.mark-row .act { color: #1aad19; font-size: 26rpx; }

/* 模态弹窗共用 */
.modal-mask { position: fixed; top:0; left:0; right:0; bottom:0; background: rgba(0,0,0,0.5); z-index:100; }
.modal-box { position: fixed; top: 20%; left: 32rpx; right: 32rpx; background: #fff; border-radius: 20rpx; padding: 32rpx; z-index:101; }
.modal-header { display: flex; justify-content: space-between; align-items: center; font-size: 32rpx; font-weight: 600; margin-bottom: 16rpx; }
.modal-close { font-size: 36rpx; color: #999; padding: 8rpx; }
.form-label { font-size: 26rpx; color: #666; margin-top: 20rpx; margin-bottom: 8rpx; display: block; }
.btn-row { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 8rpx; }
.opt-btn { padding: 12rpx 24rpx; border-radius: 8rpx; background: #f7f7f7; font-size: 26rpx; color: #666; border: 2rpx solid #f7f7f7; flex-shrink: 0; }
.opt-btn.on { background: #e8f5e9; border-color: #1aad19; color: #1aad19; font-weight: 600; }
.form-input { background: #f7f7f7; border-radius: 12rpx; padding: 20rpx; font-size: 28rpx; margin-top: 8rpx; width: 100%; box-sizing: border-box; }
.modal-actions { display: flex; gap: 16rpx; }
.modal-actions .btn-primary { flex: 1; }
.btn-primary { background: #1aad19; color: #fff; padding: 20rpx; border-radius: 12rpx; font-size: 28rpx; border: none; text-align: center; }
.btn-hover { background: #17a818; opacity: 0.9; }
.btn-outline { flex: 1; background: #fff; color: #666; border: 2rpx solid #ddd; padding: 20rpx; border-radius: 12rpx; font-size: 28rpx; text-align: center; }

/* 二维码异常：通知负责人 */
.qr-notice { border: 2rpx solid #ff7a45; background: #fff7f0; }

/* 群二维码展示卡片 */
.qr-show-box { display: flex; flex-direction: column; align-items: center; padding: 8rpx 0 16rpx; }
.qr-show-img { width: 420rpx; height: 420rpx; border-radius: 16rpx; background: #f7f7f7; }
.qr-show-tip { font-size: 22rpx; color: #999; margin-top: 12rpx; }
.qr-show-warn { font-size: 22rpx; color: #d4380d; margin-top: 12rpx; font-weight: 600; }
.qr-notice .section-title text { color: #d4380d; }
.qr-notice-text { font-size: 26rpx; color: #595959; line-height: 1.6; margin: 8rpx 0 16rpx; }
.qr-notice-desc { font-size: 26rpx; color: #888; line-height: 1.6; margin-bottom: 20rpx; display: block; }
.qr-notice-btn { background: #ff7a45; color: #fff; padding: 20rpx; border-radius: 12rpx; font-size: 28rpx; text-align: center; }
.qr-notice-btn.disabled { background: #ffbf96; }

/* ===== 催建群进度 ===== */
.qr-progress { margin: 12rpx 0 22rpx; }
.qr-progress-head { display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 12rpx; }
.qr-progress-num { font-size: 44rpx; font-weight: 700; color: #ff7a45; line-height: 1; }
.qr-progress-total { font-size: 24rpx; font-weight: 400; color: #8c8c8c; margin-left: 6rpx; }
.qr-progress-hint { font-size: 24rpx; color: #d4380d; }
.qr-progress-hint.done { color: #1aad19; font-weight: 600; }
.qr-bar-wrap { height: 16rpx; background: #ffe7d6; border-radius: 8rpx; overflow: hidden; }
.qr-bar { height: 100%; background: linear-gradient(90deg, #ff9c6e, #ff7a45); border-radius: 8rpx; transition: width 0.35s ease; }
.qr-bar.done { background: linear-gradient(90deg, #73d13d, #1aad19); }
.qr-avatars { display: flex; flex-wrap: wrap; margin-top: 18rpx; }
.qr-avatar { display: flex; flex-direction: column; align-items: center; width: 96rpx; margin-right: 8rpx; }
.qr-avatar-img { width: 56rpx; height: 56rpx; border-radius: 50%; background: #ffe7d6; }
.qr-avatar-fb { display: flex; align-items: center; justify-content: center; font-size: 26rpx; }
.qr-avatar-name { font-size: 20rpx; color: #8c8c8c; margin-top: 6rpx; max-width: 92rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.qr-share-btn { margin-top: 16rpx; background: #fff; color: #ff7a45; border: 2rpx solid #ff7a45; border-radius: 12rpx; font-size: 26rpx; line-height: 2.6; padding: 0; }
.qr-share-btn::after { border: none; }
.qr-notice-foot { display: block; font-size: 22rpx; color: #bfbfbf; text-align: center; margin-top: 14rpx; line-height: 1.5; }

/* 自定义底部操作面板 */
.action-sheet-mask { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.5); z-index: 200; }
.action-sheet { position: fixed; left: 0; right: 0; bottom: 0; background: #fff; border-radius: 20rpx 20rpx 0 0; z-index: 201; padding: 20rpx 0; }
.action-sheet-title { text-align: center; font-size: 28rpx; color: #999; padding: 20rpx; border-bottom: 1rpx solid #f5f5f5; }
.action-sheet-item { text-align: center; font-size: 32rpx; color: #333; padding: 28rpx; border-bottom: 1rpx solid #f5f5f5; }
.action-sheet-item:active { background: #f5f5f5; }
.action-sheet-cancel { text-align: center; font-size: 32rpx; color: #999; padding: 28rpx; margin-top: 12rpx; }
.action-sheet-cancel:active { background: #f5f5f5; }

/* 标牌标签 */
.badge-row { display: flex; align-items: center; gap: 12rpx; margin-top: 12rpx; flex-wrap: wrap; }
.badge { font-size: 22rpx; padding: 6rpx 18rpx; border-radius: 24rpx; line-height: 1.4; }
.badge-label { color: #fff; font-weight: 600; }
.badge-label:empty { display: none; }
/* 白金标 / 金标 / 精英标 / 普通标 */
.badge-source { color: #888; background: #f0f0f0; }
/* 标牌等级配色 */
.lb-baijin { background: linear-gradient(135deg, #7a5cff, #b48cff); } /* 白金标：紫金 */
.lb-jin { background: linear-gradient(135deg, #f5a623, #ffd75e); color: #7a4d00; } /* 金标 */
.lb-jingying { background: linear-gradient(135deg, #e05a5a, #ff9a76); } /* 精英标 */
.lb-putong { background: #9aa5b1; } /* 普通标 */

/* ===== 跑友互助 ===== */
.help-title { display: flex; align-items: center; justify-content: space-between; }
.help-head-actions { display: flex; align-items: center; gap: 20rpx; }
.help-mine-link { font-size: 24rpx; color: #888; font-weight: 400; }
.help-add { font-size: 24rpx; color: #fff; background: #1aad19; padding: 8rpx 22rpx; border-radius: 22rpx; font-weight: 500; }
.help-add.disabled { opacity: 0.45; }
.help-locked { font-size: 26rpx; color: #999; line-height: 1.6; padding: 10rpx 0 4rpx; }
.help-empty { font-size: 26rpx; color: #bbb; text-align: center; padding: 32rpx 0; }

.help-item { border-bottom: 2rpx solid #f2f2f2; padding: 20rpx 0; }
.help-item:last-of-type { border-bottom: none; }
.help-item-head { display: flex; align-items: center; gap: 10rpx; }
.help-item-icon { font-size: 30rpx; }
.help-item-title { font-size: 28rpx; color: #222; font-weight: 600; flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.help-item-tag { font-size: 20rpx; color: #1aad19; background: rgba(26,173,25,0.1); padding: 4rpx 12rpx; border-radius: 6rpx; flex-shrink: 0; }
.help-item-desc { display: block; font-size: 25rpx; color: #888; line-height: 1.5; margin-top: 8rpx; }
.help-item-foot { display: flex; align-items: center; flex-wrap: wrap; gap: 16rpx; margin-top: 10rpx; }
.help-item-cost, .help-item-people, .help-item-left, .help-item-apply { font-size: 22rpx; color: #999; }
.help-item-left.urgent { color: #ff4d4f; }
.help-disclaimer { display: block; font-size: 21rpx; color: #bbb; margin-top: 16rpx; }

/* 互助弹窗 */
.help-modal { top: 8%; bottom: 8%; display: flex; flex-direction: column; padding: 24rpx 28rpx; }
.help-body { flex: 1; min-height: 0; }
.modal-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 10rpx; }
.modal-header text:first-child { font-size: 30rpx; font-weight: 600; color: #222; }
.modal-close { font-size: 32rpx; color: #bbb; padding: 4rpx 8rpx; }
.modal-actions { display: flex; gap: 20rpx; margin-top: 32rpx; }

.help-types { display: flex; gap: 16rpx; margin-top: 8rpx; }
.help-type { flex: 1; text-align: center; font-size: 26rpx; padding: 18rpx 0; border: 2rpx solid #e5e5e5; border-radius: 12rpx; color: #666; }
.help-type.on { border-color: #1aad19; color: #1aad19; background: rgba(26,173,25,0.06); font-weight: 600; }
.help-textarea { background: #f7f7f7; border-radius: 12rpx; padding: 20rpx; font-size: 28rpx; width: 100%; box-sizing: border-box; height: 140rpx; margin-top: 8rpx; }
.help-date.placeholder { color: #aaa; }

.help-rule { background: #fbfbfb; border: 2rpx solid #eee; border-radius: 12rpx; padding: 20rpx; margin-top: 28rpx; }
.help-rule-title { display: block; font-size: 26rpx; font-weight: 600; color: #333; margin-bottom: 10rpx; }
.help-rule-text { display: block; font-size: 24rpx; color: #888; line-height: 1.7; white-space: pre-wrap; }
.help-agree { display: flex; align-items: center; gap: 14rpx; margin-top: 20rpx; }
.help-checkbox { width: 36rpx; height: 36rpx; border: 2rpx solid #ccc; border-radius: 8rpx; display: flex; align-items: center; justify-content: center; font-size: 24rpx; color: #fff; flex-shrink: 0; }
.help-checkbox.on { background: #1aad19; border-color: #1aad19; }
.help-agree-text { font-size: 26rpx; color: #444; }

/* 互助详情 */
.help-d-title { font-size: 32rpx; font-weight: 700; color: #222; }
.help-d-meta { display: flex; gap: 16rpx; margin-top: 14rpx; flex-wrap: wrap; }
.help-d-meta text { font-size: 22rpx; color: #999; background: #f5f5f5; padding: 6rpx 14rpx; border-radius: 6rpx; }
.help-d-meta text.urgent { color: #ff4d4f; background: rgba(255,77,79,0.08); }
.help-d-row { display: flex; gap: 16rpx; margin-top: 16rpx; font-size: 26rpx; color: #555; line-height: 1.6; }
.help-d-k { color: #999; flex-shrink: 0; }
.help-d-owner { font-size: 24rpx; color: #999; margin-top: 18rpx; }
.help-d-tip { display: block; font-size: 23rpx; color: #aaa; line-height: 1.7; background: #fafafa; padding: 16rpx; border-radius: 10rpx; margin-top: 20rpx; }

/* 我的互助 */
.help-tabs { display: flex; gap: 12rpx; border-bottom: 2rpx solid #f0f0f0; margin-bottom: 6rpx; }
.help-tab { flex: 1; text-align: center; font-size: 27rpx; color: #888; padding: 18rpx 0; }
.help-tab.on { color: #1aad19; font-weight: 600; border-bottom: 4rpx solid #1aad19; }
.help-mine-item { border-bottom: 2rpx solid #f2f2f2; padding: 20rpx 0; }
.help-mine-head { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; }
.help-mine-title { font-size: 28rpx; color: #222; font-weight: 600; flex: 1; }
.help-mine-status { font-size: 21rpx; color: #999; background: #f5f5f5; padding: 4rpx 12rpx; border-radius: 6rpx; flex-shrink: 0; }
.help-mine-status.on { color: #1aad19; background: rgba(26,173,25,0.1); }
.help-mine-row { font-size: 24rpx; color: #999; margin-top: 8rpx; }
.help-applicant { background: #fafafa; border-radius: 10rpx; padding: 14rpx 16rpx; margin-top: 12rpx; }
.help-ap-name { display: block; font-size: 25rpx; color: #333; font-weight: 600; }
.help-ap-msg { display: block; font-size: 24rpx; color: #888; margin-top: 6rpx; }
.help-ap-contact { display: block; font-size: 24rpx; color: #1aad19; margin-top: 6rpx; }
.help-mine-btns { display: flex; justify-content: flex-end; margin-top: 14rpx; }
.help-mine-btn { font-size: 24rpx; color: #999; border: 2rpx solid #ddd; padding: 8rpx 24rpx; border-radius: 20rpx; }
