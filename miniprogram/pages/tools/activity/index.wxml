<!-- pages/tools/activity/index.wxml -->
<view class="page">
  <!-- 未注册用户：活动内容一律不展示，只留引导 -->
  <view class="join-gate" wx:if="{{needJoin}}">
    <text class="join-gate-icon">🏃</text>
    <text class="join-gate-title">活动内容仅对跑团成员开放</text>
    <text class="join-gate-desc">你还没有注册加入。完成注册并通过后，即可查看活动、报名和参与抽奖。</text>
    <view class="join-gate-btn" bindtap="goRegister">立即注册加入</view>
  </view>

  <block wx:else>
  <view class="tabs">
    <text class="tab {{tab === 'all' ? 'on' : ''}}" bindtap="onTab" data-t="all">所有活动</text>
    <text class="tab {{tab === 'my' ? 'on' : ''}}" bindtap="onTab" data-t="my">我的活动</text>
    <text class="tab {{tab === 'lottery' ? 'on' : ''}}" bindtap="onTab" data-t="lottery">抽奖</text>
  </view>

  <view class="list" wx:if="{{tab === 'all'}}">
    <!-- 筛选 -->
    <scroll-view class="filter-row" scroll-x>
      <text class="filter-chip {{filterIdx === idx ? 'on' : ''}}" wx:for="{{filterOptions}}" wx:key="*this" wx:for-index="idx" data-idx="{{idx}}" bindtap="onFilter">{{item}}</text>
    </scroll-view>
    <view class="act-card" wx:for="{{activities}}" wx:key="_id" bindtap="onDetail" data-id="{{item._id}}">
      <view class="card-body">
        <view class="card-row1">
          <text class="card-name">{{item.name}}</text>
          <text class="state-tag {{item.stateTag.cls}}">{{item.stateTag.text}}</text>
        </view>
        <text class="card-info">📅 {{item._fmtStart}} 📍 {{item.location}}</text>
        <text class="card-count">👥 {{item.regCount || 0}}{{item.maxPeople ? '/' + item.maxPeople : ''}} 人已报名</text>
        <text class="card-fee" wx:if="{{item.fee}}">💰 {{item.fee}}</text>
      </view>
    </view>
    <view wx:if="{{!activities.length}}" class="empty">暂无活动</view>
    <view class="load-more" wx:if="{{hasMore}}" bindtap="onLoadMore">加载更多</view>
  </view>

  <view class="list" wx:if="{{tab === 'my'}}">
    <view class="act-card" wx:for="{{myActivities}}" wx:key="_id">
      <view class="card-body" bindtap="onDetail" data-id="{{item._id}}">
        <text class="card-name">{{item.name}}</text>
        <text class="card-info">📅 {{item._fmtStart}} 📍 {{item.location}}</text>
        <text class="card-count">👥 {{item.regCount || 0}} 人已报名</text>
      </view>
      <text class="unreg-btn" catchtap="onUnregister" data-id="{{item._id}}">取消</text>
    </view>
    <view wx:if="{{!myActivities.length}}" class="empty">还没报名活动</view>
  </view>

  <view class="list" wx:if="{{tab === 'lottery'}}">
    <view class="act-card" wx:for="{{allLotteries}}" wx:key="_id" bindtap="onLotteryDetail" data-id="{{item._id}}">
      <view class="card-body">
        <view class="card-row1">
          <text class="card-name">{{item.name}}</text>
          <text class="tag {{item.stateTag.cls}}">{{item.stateTag.text}}</text>
        </view>
        <text class="card-info">🕐 {{item._fmtStart || '--'}} ~ {{item._fmtEnd || '--'}}</text>
        <text class="card-count">🎫 {{item.usedCount || 0}}/{{item.codeCount}} 人已参与</text>
        <text class="card-count" wx:if="{{item.prizes && item.prizes.length}}">
          🏆 <text wx:for="{{item.prizes}}" wx:key="name" style="margin-right:8rpx;">{{item.name}}×{{item.count}}</text>
        </text>
      </view>
    </view>
    <view wx:if="{{!allLotteries.length}}" class="empty">暂无抽奖活动</view>
    <view class="load-more" wx:if="{{lotHasMore}}" bindtap="onLotLoadMore">加载更多</view>
  </view>
  </block>
</view>
