/* pages/tools/ledger/add.wxss */
.add-page { padding-bottom: 80rpx; }

.page-title { font-size: 34rpx; font-weight: 700; display: block; margin-bottom: 24rpx; }
.edit-badge { font-size: 24rpx; color: #999; font-weight: 400; margin-left: 8rpx; }

.form-label {
  font-size: 28rpx; color: #666; margin: 28rpx 0 12rpx; display: block;
}
.form-label:first-of-type { margin-top: 0; }

/* 大类 */
.opt-row { display: flex; gap: 20rpx; }
.opt-btn {
  flex: 1; text-align: center; padding: 20rpx 0; border-radius: 12rpx;
  background: #f5f5f5; color: #666; font-size: 28rpx;
}
.opt-btn.on { background: #e8f5e9; color: #1aad19; font-weight: 600; border: 2rpx solid #1aad19; }

/* 小类 */
.sub-grid { display: flex; flex-wrap: wrap; gap: 16rpx; }
.sub-btn {
  padding: 14rpx 28rpx; border-radius: 30rpx; font-size: 26rpx;
  background: #f5f5f5; color: #666;
}
.sub-btn.on { background: #1aad19; color: #fff; font-weight: 600; }
.custom-row { margin-top: 16rpx; }

/* 输入 */
.form-input {
  width: 100%; box-sizing: border-box;
  padding: 22rpx 20rpx; background: #f7f7f7; border-radius: 12rpx; font-size: 28rpx;
}
.amount-input { font-size: 36rpx; font-weight: 600; color: #ff4d4f; }
.picker-box {
  padding: 22rpx 20rpx; background: #f7f7f7; border-radius: 12rpx; font-size: 28rpx;
  color: #333;
}
.desc-input {
  width: 100%; box-sizing: border-box; min-height: 120rpx;
  padding: 22rpx 20rpx; background: #f7f7f7; border-radius: 12rpx; font-size: 28rpx;
}

/* 图片 */
.img-grid { display: flex; flex-wrap: wrap; gap: 16rpx; margin-top: 8rpx; }
.img-wrap { position: relative; width: 180rpx; height: 180rpx; }
.img-item { width: 180rpx; height: 180rpx; border-radius: 12rpx; background: #f0f0f0; }
.img-del {
  position: absolute; top: -12rpx; right: -12rpx;
  width: 44rpx; height: 44rpx; line-height: 40rpx; text-align: center;
  background: rgba(0,0,0,0.6); color: #fff; border-radius: 50%; font-size: 26rpx;
}
.img-add {
  width: 180rpx; height: 180rpx; border-radius: 12rpx;
  border: 2rpx dashed #ccc; display: flex; flex-direction: column;
  align-items: center; justify-content: center; color: #999;
}
.img-add-icon { font-size: 56rpx; line-height: 1; }
.img-add-text { font-size: 22rpx; margin-top: 8rpx; }

.btn-area { padding: 32rpx 24rpx; }
.btn-reject {
  width: 100%; background: #fff; color: #ff4d4f;
  border: 2rpx solid #ff4d4f; border-radius: 12rpx;
  padding: 22rpx 0; font-size: 30rpx; text-align: center;
}
/* 赛事选择 */
.race-custom-row { margin-top: 16rpx; }
.go-mark-row {
  margin-top: 16rpx; padding: 18rpx 20rpx;
  background: #fff7e6; border-radius: 12rpx;
}
.go-mark-text { font-size: 26rpx; color: #fa8c16; }
