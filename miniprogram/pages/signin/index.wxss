/* pages/signin/index.wxss - 每日签到 */
.signin-page { padding: 24rpx 24rpx 60rpx; }
.rule-link {
  text-align: right;
  font-size: 26rpx;
  color: #1aad19;
  margin-bottom: 16rpx;
}

/* 顶部 */
.hero {
  background: linear-gradient(135deg, #1aad19, #0d8c0d);
  border-radius: 24rpx;
  padding: 48rpx 40rpx 40rpx;
  text-align: center;
  color: #fff;
}
.hero-label { font-size: 26rpx; color: rgba(255,255,255,0.75); display: block; }
.hero-num-row { display: flex; align-items: baseline; justify-content: center; margin-top: 8rpx; }
.hero-num { font-size: 96rpx; font-weight: 700; line-height: 1; }
.hero-unit { font-size: 30rpx; color: rgba(255,255,255,0.8); margin-left: 12rpx; }
.hero-sub { font-size: 24rpx; color: rgba(255,255,255,0.75); display: block; margin-top: 12rpx; }
.hero-tip {
  margin-top: 24rpx; display: inline-block;
  background: rgba(255,255,255,0.18);
  border-radius: 999rpx;
  padding: 10rpx 28rpx;
  font-size: 24rpx;
}
.cycle-bar {
  margin-top: 20rpx;
  height: 12rpx;
  background: rgba(255,255,255,0.25);
  border-radius: 6rpx;
  overflow: hidden;
}
.cycle-bar-inner {
  height: 100%;
  background: #fff;
  border-radius: 6rpx;
  transition: width 0.3s;
}
.makeup-tip { font-size: 26rpx; color: #ff6b00; }

.card {
  background: #fff;
  border-radius: 20rpx;
  margin-top: 20rpx;
  padding: 28rpx;
}

/* 签到按钮 */
.sign-area { text-align: center; padding: 36rpx 28rpx; }
.sign-btn {
  background: linear-gradient(135deg, #ff9a3c, #ff6b00);
  color: #fff;
  font-size: 36rpx;
  font-weight: 600;
  border-radius: 999rpx;
  width: 70%;
  height: 96rpx;
  line-height: 96rpx;
  padding: 0;
  border: none;
}
.sign-btn.signed {
  background: #e8e8e8;
  color: #999;
}
.sign-btn::after { border: none; }
.preview { margin-top: 24rpx; }
.preview-main { font-size: 30rpx; color: #333; }
.preview-num { font-size: 36rpx; font-weight: 700; color: #ff6b00; }
.preview-sub { font-size: 24rpx; color: #999; display: block; margin-top: 8rpx; }

/* 月历 */
.calendar-card { padding: 28rpx 24rpx; }
.cal-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16rpx; }
.cal-title { font-size: 30rpx; font-weight: 600; color: #333; }
.cal-legend { display: flex; }
.legend-item { display: flex; align-items: center; margin-left: 16rpx; font-size: 20rpx; color: #999; }
.dot { width: 14rpx; height: 14rpx; border-radius: 50%; margin-right: 6rpx; }
.dot-signed { background: #1aad19; }
.dot-makeup { background: #ffb74d; }
.cal-week-row { display: flex; margin-bottom: 8rpx; }
.cal-week { flex: 1; text-align: center; font-size: 22rpx; color: #999; }
.cal-grid { display: flex; flex-wrap: wrap; }
.cal-cell { width: 14.28%; display: flex; justify-content: center; margin: 6rpx 0; }
.cal-day {
  width: 64rpx; height: 64rpx;
  border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  font-size: 26rpx; color: #333;
  position: relative;
}
.cal-day.empty { background: transparent; }
.cal-day.signed { background: #1aad19; color: #fff; }
.cal-day.makeup { background: #ffb74d; color: #fff; }
.cal-day.today { box-shadow: 0 0 0 3rpx #ff6b00; font-weight: 700; }
.today-bar {
  position: absolute; bottom: 4rpx; left: 50%; transform: translateX(-50%);
  width: 10rpx; height: 6rpx; border-radius: 3rpx; background: #ff6b00;
}

/* 补签卡入口 */
.cards-entry { display: flex; justify-content: space-between; align-items: center; }
.cards-left { flex: 1; }
.cards-title { font-size: 30rpx; font-weight: 600; color: #333; display: block; }
.cards-sub { font-size: 24rpx; color: #999; margin-top: 8rpx; display: block; }
.cards-right { display: flex; align-items: center; position: relative; }
.red-dot {
  width: 18rpx; height: 18rpx; border-radius: 50%;
  background: #ff4d4f;
  margin-right: 12rpx;
}
.arrow { font-size: 40rpx; color: #ccc; }

/* 积分余额 + 兑换 */
.balance-row { display: flex; justify-content: space-between; align-items: center; }
.balance-left { flex: 1; }
.balance-label { font-size: 24rpx; color: #999; display: block; }
.balance-num { font-size: 52rpx; font-weight: 700; color: #333; }
.balance-unit { font-size: 26rpx; color: #999; margin-left: 6rpx; }
.exchange-btn {
  background: #1aad19; color: #fff;
  font-size: 28rpx;
  border-radius: 999rpx;
  padding: 0 36rpx;
  height: 72rpx;
  line-height: 72rpx;
  margin: 0;
}
.exchange-btn::after { border: none; }

/* 规则说明 */
.rule-note {
  margin-top: 20rpx;
  background: #f0f9f0;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  font-size: 24rpx;
  color: #555;
  line-height: 1.6;
}

/* 弹窗 */
.mask {
  position: fixed; left: 0; top: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.5);
  display: flex; align-items: center; justify-content: center;
  z-index: 100;
}
.modal {
  width: 600rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 40rpx 36rpx;
}
.modal-title { font-size: 34rpx; font-weight: 700; color: #333; text-align: center; display: block; margin-bottom: 28rpx; }
.modal-row { display: flex; justify-content: space-between; padding: 14rpx 0; }
.row-label { font-size: 28rpx; color: #666; }
.row-value { font-size: 28rpx; color: #333; font-weight: 600; }
.modal-tip { font-size: 22rpx; color: #999; display: block; margin-top: 12rpx; }
.modal-btns { display: flex; gap: 24rpx; margin-top: 36rpx; }
.btn-cancel {
  flex: 1; background: #f0f0f0; color: #666;
  font-size: 30rpx; border-radius: 999rpx; height: 80rpx; line-height: 80rpx; padding: 0;
}
.btn-cancel::after { border: none; }
.btn-confirm {
  flex: 1; background: #1aad19; color: #fff;
  font-size: 30rpx; border-radius: 999rpx; height: 80rpx; line-height: 80rpx; padding: 0;
}
.btn-confirm::after { border: none; }