@import './common.wxss';
.record-note { font-size: 24rpx; color: #666; margin-top: 12rpx; display: block; line-height: 1.5; }
.record-img { width: 100%; height: 320rpx; border-radius: 12rpx; margin-top: 16rpx; background: #f5f5f5; }
.record-img-empty { width: 100%; height: 120rpx; border-radius: 12rpx; margin-top: 16rpx; background: #f8f8f8; color: #bbb; font-size: 24rpx; display: flex; align-items: center; justify-content: center; }
