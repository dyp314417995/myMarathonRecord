@import './common.wxss';
.record-note { font-size: 24rpx; color: #666; margin-top: 12rpx; display: block; line-height: 1.5; }

/* 打卡截图：列表里放缩略图（完整显示，不裁切），点击预览看大图 */
.record-img-wrap { margin-top: 16rpx; }
.record-img {
  width: 220rpx; height: 220rpx; border-radius: 12rpx; background: #f5f5f5;
  border: 2rpx solid #eee;
}
.record-img-empty {
  width: 220rpx; height: 220rpx; border-radius: 12rpx; background: #f8f8f8; color: #bbb;
  font-size: 24rpx; display: flex; align-items: center; justify-content: center;
}
.record-img-tip { display: block; font-size: 22rpx; color: #1aad19; margin-top: 10rpx; }
