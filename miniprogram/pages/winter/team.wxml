<!-- pages/winter/team.wxml - 我的组 -->
<view class="winter-page">
  <view class="loading" wx:if="{{loading}}">加载中…</view>
  <block wx:else>
    <view class="hero">
      <text class="hero-title">{{group.emblem}} {{group.name}}</text>
      <text class="hero-sub">{{group.desc}}</text>
      <image wx:if="{{sloganImage}}" class="hero-photo" src="{{sloganImage}}" mode="aspectFill" bindtap="onPreviewSlogan" />
      <text class="hero-slogan" wx:if="{{group.slogan}}">“{{group.slogan}}”</text>
      <text class="hero-tip">{{weekText}} · 我的角色：{{me.roleText}}</text>
      <text class="hero-edit" wx:if="{{isBoss || me.isAdmin}}" bindtap="onEditGroupInfo">✏️ 编辑宣言 / 照片</text>
    </view>

    <button class="btn btn-ghost share-btn" open-type="share">邀请好友加入本组</button>

    <view class="frozen-bar notice-bar" wx:if="{{frozen}}">{{frozenText}}</view>

    <!-- 队长：待审批入队申请 -->
    <view class="card" wx:if="{{isLeader && pendingApplies.length > 0}}">
      <text class="card-title">待审批入队（{{pendingApplies.length}} 人）</text>
      <text class="card-sub">缴费由你线下收款后自行标记，不阻塞审批</text>
      <view class="member-row" wx:for="{{pendingApplies}}" wx:key="userId">
        <view class="member-info">
          <text class="member-name">{{item.nickName}} <text class="tag tag-gray">{{item.roleText}}</text></text>
          <text class="member-meta">近期成绩 {{item.recentResult || '未填'}} · 目标 {{item.target || '未填'}}</text>
          <text class="member-meta" wx:if="{{item.reason}}">申请理由：{{item.reason}}</text>
          <text class="member-meta">
            缴费：
            <text class="tag {{item.feeStatus === 'paid' ? 'tag-green' : (item.feeStatus === 'free' ? 'tag-blue' : 'tag-orange')}}">{{item.feeStatus === 'paid' ? '已缴费' : (item.feeStatus === 'free' ? '免费' : '未缴费')}}</text>
          </text>
        </view>
        <view class="member-right">
          <text class="mini-btn mini-ghost" data-uid="{{item.userId}}" data-fee="{{item.feeStatus}}" bindtap="onToggleFee">{{item.feeStatus === 'paid' ? '改免费' : (item.feeStatus === 'free' ? '改未缴' : '标记已缴')}}</text>
          <view class="mini-btn-row">
            <text class="mini-btn mini-ghost" data-uid="{{item.userId}}" data-pass="{{false}}" bindtap="onLeaderReview">驳回</text>
            <text class="mini-btn" data-uid="{{item.userId}}" data-pass="{{true}}" bindtap="onLeaderReview">通过</text>
          </view>
        </view>
      </view>
    </view>

    <view class="card">
      <text class="card-title">本组 KPI 区间</text>
      <text class="row-value">{{kpiRangeText}}</text>
      <text class="card-sub" style="margin-top:16rpx" wx:if="{{kpiRange}}">由教练在{{kpiRange.effectiveWeek ? ('第' + kpiRange.effectiveWeek + '周') : ''}}发布，保存即生效</text>
      <text class="card-sub" style="margin-top:16rpx" wx:else>等待教练发布区间后，队员即可在区间内填报 KPI</text>
      <view style="margin-top:20rpx">
        <button class="btn btn-ghost" wx:if="{{me.role === 'coach'}}" bindtap="onGoKpi">设定区间 · 填报我的 KPI</button>
        <button class="btn kpi-btn" wx:else bindtap="onGoKpi">{{kpiBtnText}}</button>
      </view>
    </view>

    <view class="card">
      <text class="card-title">队长 / 教练</text>
      <view class="member-row" wx:if="{{leader}}">
        <image wx:if="{{leader.avatarUrl}}" class="member-avatar" src="{{leader.avatarUrl}}" mode="aspectFill" binderror="onAvatarError" data-k="leader" />
        <view wx:else class="member-avatar avatar-fallback">{{leader.avatarInitial || '?'}}</view>
        <view class="member-info">
          <text class="member-name">{{leader.nickName}} <text class="tag tag-green">队长</text></text>
          <text class="member-meta">KPI {{leader.kpiValue}}{{leader.kpiType === 'attendance' ? ' 天' : ' 公里'}}{{leader.remark ? ' · ' + leader.remark : ''}}</text>
        </view>
        <view class="member-right"><text class="tag {{leader.continuousFailWeeks > 0 ? 'tag-red' : 'tag-gray'}}" wx:if="{{leader.continuousFailWeeks > 0}}">未完成{{leader.continuousFailWeeks}}周</text></view>
      </view>
      <view class="empty" wx:else style="padding:24rpx">队长待任命</view>
      <view class="member-row" wx:if="{{coach}}">
        <image wx:if="{{coach.avatarUrl}}" class="member-avatar" src="{{coach.avatarUrl}}" mode="aspectFill" binderror="onAvatarError" data-k="coach" />
        <view wx:else class="member-avatar avatar-fallback">{{coach.avatarInitial || '?'}}</view>
        <view class="member-info">
          <text class="member-name">{{coach.nickName}} <text class="tag tag-blue">教练</text></text>
          <text class="member-meta">KPI {{coach.kpiValue}}{{coach.kpiType === 'attendance' ? ' 天' : ' 公里'}}{{coach.remark ? ' · ' + coach.remark : ''}}</text>
        </view>
      </view>
      <view class="empty" wx:else style="padding:24rpx">教练待任命</view>
      <text class="card-sub" wx:if="{{isBoss}}" style="margin-top:16rpx">需要交接？在下方队员列表点「转让{{me.roleText}}」即可，无需审批</text>
    </view>

    <view class="card">
      <text class="card-title">队员（{{mates.length}} 人）</text>
      <view class="member-row" wx:for="{{mates}}" wx:key="_id">
        <image wx:if="{{item.avatarUrl}}" class="member-avatar" src="{{item.avatarUrl}}" mode="aspectFill" binderror="onAvatarError" data-k="mates" data-i="{{index}}" />
        <view wx:else class="member-avatar avatar-fallback">{{item.avatarInitial || '?'}}</view>
        <view class="member-info">
          <text class="member-name">{{item.nickName}}
            <text class="tag {{item.feeStatus === 'paid' ? 'tag-green' : (item.feeStatus === 'free' ? 'tag-blue' : 'tag-orange')}}">{{item.feeStatus === 'paid' ? '已缴费' : (item.feeStatus === 'free' ? '免费' : '未缴费')}}</text>
          </text>
          <text class="member-meta">KPI {{item.kpiValue}}{{item.kpiType === 'attendance' ? ' 天' : ' 公里'}}{{item.remark ? ' · ' + item.remark : ''}}</text>
          <view class="mini-btn-row" wx:if="{{isLeader || isBoss}}">
            <text wx:if="{{isLeader}}" class="mini-btn mini-ghost" data-uid="{{item.userId}}" data-fee="{{item.feeStatus}}" bindtap="onToggleFee">{{item.feeStatus === 'paid' ? '改免费' : (item.feeStatus === 'free' ? '改未缴' : '标记已缴')}}</text>
            <text wx:if="{{isBoss}}" class="mini-btn mini-ghost" data-uid="{{item.userId}}" data-nick="{{item.nickName}}" bindtap="onTransferRole">转让{{me.roleText}}</text>
          </view>
        </view>
        <view class="member-right">
          <text class="tag {{item.continuousFailWeeks > 0 ? 'tag-red' : 'tag-green'}}">{{item.continuousFailWeeks > 0 ? ('未完成' + item.continuousFailWeeks + '周') : '正常'}}</text>
        </view>
      </view>
      <view class="empty" wx:if="{{mates.length === 0}}">暂无队员</view>
    </view>

    <!-- 我的请假 -->
    <view class="card">
      <view class="card-head">
        <text class="card-title">请假</text>
        <text class="tag tag-blue" bindtap="onOpenLeave">＋ 申请请假</text>
      </view>
      <text class="card-sub">伤病 / 事假 / 参赛调整都可以，单次最长 7 天；队长审批通过后该周不考核</text>
      <view class="member-row" wx:for="{{leaves}}" wx:key="_id">
        <view class="member-info">
          <text class="member-name">{{item.startDate}} ~ {{item.endDate}}（{{item.days}} 天）</text>
          <text class="member-meta">{{item.typeText || '其他'}}{{item.reason ? ' · ' + item.reason : ''}}</text>
        </view>
        <view class="member-right">
          <text class="tag {{item.status === 'approved' ? 'tag-green' : (item.status === 'rejected' ? 'tag-red' : 'tag-orange')}}">{{item.status === 'approved' ? '已批准' : (item.status === 'rejected' ? '已驳回' : '待审批')}}</text>
        </view>
      </view>
      <view class="empty" wx:if="{{leaves.length === 0}}">暂无请假记录</view>
    </view>

    <view class="quit-row">
      <text class="quit-link" bindtap="onQuitGroup">退出本组</text>
      <text class="quit-tip">退出后可重新报名加入其他组；打卡记录保留，KPI 按新组重新填报</text>
    </view>
  </block>

  <!-- 队长/教练：编辑本组宣言与照片 -->
  <view class="modal-mask" wx:if="{{showGroupEdit}}">
    <view class="modal-box">
      <text class="modal-title">编辑队伍宣言 / 照片</text>
      <view class="field">
        <text class="field-label">宣言口号（20 字以内）</text>
        <input class="input" value="{{groupEdit.slogan}}" data-f="slogan" bindinput="onGroupEditInput" maxlength="20" placeholder="写一句给全队打气的话" />
      </view>
      <view class="field">
        <text class="field-label">队伍照片</text>
        <image wx:if="{{groupEdit.sloganImagePreview}}" class="group-photo" src="{{groupEdit.sloganImagePreview}}" mode="aspectFill" bindtap="onPreviewGroupPhoto" />
        <view wx:else class="group-photo-empty" bindtap="onChooseGroupPhoto">点击上传一张照片</view>
        <view class="chip-row" style="margin-top:16rpx">
          <text class="chip" bindtap="onChooseGroupPhoto">更换照片</text>
          <text class="chip" wx:if="{{groupEdit.sloganImage}}" bindtap="onRemoveGroupPhoto">移除照片</text>
        </view>
      </view>
      <text class="card-sub">宣言和照片会显示在队伍主页，也会作为邀请卡的标题与配图。</text>
      <view class="modal-btns">
        <button class="btn btn-gray" bindtap="onCloseGroupEdit">取消</button>
        <button class="btn" loading="{{busy}}" bindtap="onSaveGroupInfo">保存</button>
      </view>
    </view>
  </view>

  <!-- 请假申请 -->
  <view class="modal-mask" wx:if="{{showLeave}}">
    <view class="modal-box">
      <text class="modal-title">申请请假</text>
      <view class="field">
        <text class="field-label">开始日期</text>
        <picker mode="date" value="{{leaveForm.startDate}}" bindchange="onLeaveStartDate">
          <text class="row-value">{{leaveForm.startDate}} ›</text>
        </picker>
      </view>
      <view class="field">
        <text class="field-label">结束日期</text>
        <picker mode="date" value="{{leaveForm.endDate}}" start="{{leaveForm.startDate}}" bindchange="onLeaveEndDate">
          <text class="row-value">{{leaveForm.endDate}} ›</text>
        </picker>
      </view>
      <view class="field">
        <text class="field-label">原因类型</text>
        <view class="chip-row">
          <text class="chip {{leaveForm.type === 'injury' ? 'on' : ''}}" data-type="injury" bindtap="onLeaveType">伤病</text>
          <text class="chip {{leaveForm.type === 'personal' ? 'on' : ''}}" data-type="personal" bindtap="onLeaveType">事假</text>
          <text class="chip {{leaveForm.type === 'race' ? 'on' : ''}}" data-type="race" bindtap="onLeaveType">参赛调整</text>
          <text class="chip {{leaveForm.type === 'other' ? 'on' : ''}}" data-type="other" bindtap="onLeaveType">其他</text>
        </view>
      </view>
      <view class="field">
        <text class="field-label">具体原因 *</text>
        <textarea class="textarea" value="{{leaveForm.reason}}" data-f="reason" bindinput="onLeaveInput" placeholder="简单说明一下，方便队长判断"></textarea>
      </view>
      <text class="card-sub">单次最长 7 天；审批通过后，请假覆盖到的那几周不考核（不计完成率、不计罚金）。</text>
      <view class="modal-btns">
        <button class="btn btn-gray" bindtap="onCloseLeave">取消</button>
        <button class="btn" loading="{{busy}}" bindtap="onSaveLeave">提交</button>
      </view>
    </view>
  </view>
</view>
