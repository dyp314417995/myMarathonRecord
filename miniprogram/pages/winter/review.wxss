@import './common.wxss';
.loading { text-align: center; padding: 80rpx; color: #999; }

/* 待审打卡：整卡可点，展开看详情（含图片） */
.expand-hint { display: block; font-size: 22rpx; color: #1aad19; margin-top: 8rpx; }
.record-detail { margin-top: 18rpx; padding-top: 18rpx; border-top: 2rpx dashed #eee; }
.record-img { width: 100%; height: auto; border-radius: 12rpx; background: #f5f5f5; }
.detail-rows { margin-top: 18rpx; }
.detail-row { display: block; font-size: 26rpx; color: #666; line-height: 1.9; }
.record-actions { display: flex; margin-top: 22rpx; }

/* 待审入队申请 */
.apply-item { padding: 16rpx 0; border-bottom: 2rpx solid #f5f5f5; }
.apply-item:last-child { border-bottom: none; }
