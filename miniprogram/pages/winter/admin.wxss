@import './common.wxss';
.loading { text-align: center; padding: 80rpx; color: #999; }
.modal-box .textarea { height: 120rpx; }
/* 队伍照片预览 */
.group-photo { width: 100%; height: 240rpx; border-radius: 12rpx; margin-top: 12rpx; }
.group-photo-empty { width: 100%; height: 160rpx; border: 2rpx dashed #dcdfe6; border-radius: 12rpx; margin-top: 12rpx; color: #a8abb2; font-size: 26rpx; display: flex; align-items: center; justify-content: center; }

/* 成员分组查看：横向滚动的组别筛选 + 组标题 */
.filter-row { white-space: nowrap; padding: 4rpx 0 12rpx; margin-bottom: 4rpx; }
.filter-row .chip { display: inline-block; margin-right: 12rpx; }
.section-head { display: flex; align-items: baseline; justify-content: space-between; padding: 24rpx 8rpx 12rpx; }
.section-name { font-size: 30rpx; font-weight: 700; color: #333; }
.section-count { font-size: 24rpx; color: #999; }
