@import './common.wxss';
.loading { text-align: center; padding: 80rpx; color: #999; }
/* KPI 按钮：默认 button 的 overflow:hidden 会裁掉超宽末尾字符，这里允许换行 */
.kpi-btn { white-space: normal; line-height: 1.5; padding: 18rpx 20rpx; font-size: 30rpx; overflow: visible; }

/* 退出本组：弱化入口，避免误点 */
.quit-row { text-align: center; margin-top: 48rpx; padding-bottom: 24rpx; }
.quit-link { font-size: 26rpx; color: #c0c4cc; text-decoration: underline; }
.quit-tip { display: block; font-size: 22rpx; color: #c0c4cc; margin-top: 12rpx; line-height: 1.5; padding: 0 40rpx; }

/* 队伍宣言与照片 */
.hero-photo { width: 100%; height: 280rpx; border-radius: 14rpx; margin-top: 20rpx; }
.hero-slogan { display: block; font-size: 30rpx; font-weight: 600; color: #fff; margin-top: 20rpx; line-height: 1.5; }
.share-btn { margin-bottom: 24rpx; }
/* 队长编辑入口 + 弹窗里的照片 */
/* hero 背景是绿色渐变，这里必须用白色描边：之前用绿色字体在绿底上等于隐形 */
.hero-edit { display: inline-block; margin-top: 20rpx; padding: 12rpx 28rpx; border: 2rpx solid rgba(255,255,255,0.85); border-radius: 999rpx; background: rgba(255,255,255,0.18); font-size: 26rpx; color: #fff; }
.group-photo { width: 100%; height: 240rpx; border-radius: 12rpx; margin-top: 12rpx; }
.group-photo-empty { width: 100%; height: 160rpx; border: 2rpx dashed #dcdfe6; border-radius: 12rpx; margin-top: 12rpx; color: #a8abb2; font-size: 26rpx; display: flex; align-items: center; justify-content: center; }
