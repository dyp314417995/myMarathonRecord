<!-- pages/winter/kpi.wxml - KPI 填报 / 区间设定 -->
<view class="winter-page">
  <view class="loading" wx:if="{{loading}}">加载中…</view>
  <block wx:else>
    <!-- 教练：设定区间（教练同时也是队员，下方仍有自己的 KPI 填报） -->
    <block wx:if="{{isCoach}}">
      <view class="card">
        <text class="card-title">设定本组 KPI 区间</text>
        <text class="card-sub">保存即生效，队员只能在本区间内填报</text>
        <view class="notice-bar" wx:if="{{draftTip}}">📋 {{draftTip}}</view>
        <view class="field">
          <text class="field-label">考核类型</text>
          <view class="chip-row">
            <text class="chip {{form.type === 'distance' ? 'on' : ''}}" data-v="distance" bindtap="onPickType">跑量（公里/周）</text>
            <text class="chip {{form.type === 'attendance' ? 'on' : ''}}" data-v="attendance" bindtap="onPickType">出勤（天/周）</text>
          </view>
        </view>
        <view class="field">
          <text class="field-label">下限 *</text>
          <input class="input" type="digit" value="{{form.min}}" data-f="min" bindinput="onFormInput" placeholder="如 30" />
        </view>
        <view class="field">
          <text class="field-label">上限 *</text>
          <input class="input" type="digit" value="{{form.max}}" data-f="max" bindinput="onFormInput" placeholder="如 80" />
        </view>
        <view class="field">
          <text class="field-label">单次最低时长（分钟）</text>
          <input class="input" type="number" value="{{form.minDuration}}" data-f="minDuration" bindinput="onFormInput" placeholder="如 30，单次打卡时长不得低于此值" />
        </view>
        <button class="btn" loading="{{submitting}}" bindtap="onSaveRange">保存并生效</button>
      </view>
      <view class="card">
        <text class="card-title">当前生效区间</text>
        <text class="row-value">{{rangeText}}</text>
      </view>
    </block>

    <!-- 我的本周 KPI：教练 / 队长 / 队员一视同仁，按周填报、按周考核 -->
    <view class="card" wx:if="{{kpiRange}}">
      <text class="card-title">{{isCoach ? '我的本周 KPI（教练也要打卡）' : '我的本周 KPI'}}</text>
      <text class="card-sub">第 {{weekIndex}} 周 · 本组区间 {{kpiRange.min}} ~ {{kpiRange.max}} {{kpiRange.type === 'distance' ? '公里/周' : '天/周'}}{{kpiRange.minDuration ? (' · 单次≥' + kpiRange.minDuration + '分钟') : ''}}</text>
      <!-- 本周已打过卡：目标锁定，下周一解锁 -->
      <view class="locked-box" wx:if="{{kpiLocked}}">
        <text class="locked-value">本周目标：{{myKpiValue}} {{unit}}</text>
        <text class="field-tip">🔒 本周已有打卡，目标锁定；下周一可重新填报</text>
      </view>
      <block wx:else>
        <view class="field" style="margin-top:24rpx">
          <text class="field-label">本周目标（{{unit}}）</text>
          <input class="input" type="digit" value="{{kpiValue}}" bindinput="onInputValue" placeholder="请输入 {{kpiRange.min}} ~ {{kpiRange.max}} 之间的值" />
          <text class="field-tip" wx:if="{{kpiValue && !inRange}}">⚠️ 超出本组区间，无法提交</text>
          <text class="ok-tip" wx:elif="{{kpiValue && inRange}}">✅ 在区间内，本周按此目标考核</text>
        </view>
        <button class="btn {{inRange && kpiValue ? '' : 'btn-gray'}}" disabled="{{!inRange || !kpiValue || submitting}}" loading="{{submitting}}" bindtap="onSubmitKpi">{{myKpiValue ? '修改本周 KPI' : '保存本周 KPI'}}</button>
      </block>
    </view>

    <view class="card" wx:elif="{{isCoach}}">
      <text class="card-title">先发布区间，再填报你的 KPI</text>
      <text class="card-sub">教练本人也按本组区间考核，未填报 KPI 将无法打卡</text>
    </view>

    <view class="card" wx:else>
      <text class="card-title">等待教练设定区间</text>
      <text class="card-sub">教练发布 KPI 区间后，你即可在区间内填报本周目标</text>
    </view>

    <!-- 历史记录：每周目标可追溯 -->
    <view class="card" wx:if="{{kpiHistory.length}}">
      <text class="card-title">我的 KPI 记录</text>
      <view class="member-row" wx:for="{{kpiHistory}}" wx:key="weekIndex">
        <view class="member-info">
          <text class="member-name">第 {{item.weekIndex}} 周</text>
          <text class="member-meta">{{item.value}} {{item.type === 'attendance' ? '天' : '公里'}}{{item.auto ? ' · 沿用上周' : ''}}</text>
        </view>
        <view class="member-right">
          <text class="tag {{item.weekIndex === weekIndex ? 'tag-green' : 'tag-gray'}}">{{item.weekIndex === weekIndex ? '本周' : '已结束'}}</text>
        </view>
      </view>
    </view>

    <view class="notice-bar">
      💡 KPI 按周填报：每周一可重新填报本周目标；本周一旦有打卡，目标即锁定不可改；新的一周没填则自动沿用上周目标。
    </view>
  </block>
</view>
