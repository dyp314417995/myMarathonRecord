/* pages/admin/raceSignup/raceSignup.wxss */
.rs-page { padding: 24rpx; padding-bottom: 60rpx; }
.loading { text-align: center; color: #999; padding: 80rpx 0; }
.rs-head { margin-bottom: 20rpx; }
.rs-title { font-size: 34rpx; font-weight: 700; display: block; }
.rs-sub { font-size: 24rpx; color: #888; display: block; margin: 6rpx 0 12rpx; }
.rs-actions { display: flex; gap: 16rpx; }
.rs-btn { padding: 12rpx 28rpx; border-radius: 10rpx; background: #1aad19; color: #fff; font-size: 26rpx; display: inline-block; }
.rs-empty { text-align: center; color: #aaa; padding: 100rpx 0; font-size: 26rpx; }
.rs-row { display: flex; align-items: center; background: #fff; border-radius: 14rpx; padding: 20rpx 24rpx; margin-bottom: 14rpx; box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04); }
.rs-row-quit { opacity: 0.55; }
.rs-avatar { width: 76rpx; height: 76rpx; border-radius: 50%; margin-right: 20rpx; flex-shrink: 0; }
.rs-avatar-fb { display: flex; align-items: center; justify-content: center; background: #f0f0f0; }
.rs-info { flex: 1; min-width: 0; }
.rs-name-line { display: flex; align-items: center; gap: 10rpx; flex-wrap: wrap; }
.rs-name { font-size: 28rpx; font-weight: 600; }
.rs-tag { font-size: 20rpx; padding: 2rpx 12rpx; border-radius: 8rpx; }
.t-green { background: #e8f7e8; color: #1a7a1a; }
.t-blue { background: #e6f0fb; color: #2a6aa8; }
.t-gray { background: #f0f0f0; color: #999; }
.t-orange { background: #fdf2e6; color: #c07a1a; }
.rs-meta { font-size: 22rpx; color: #999; display: block; margin-top: 4rpx; }
.rs-right { display: flex; flex-direction: column; gap: 10rpx; align-items: flex-end; }
.rs-btn-mini { font-size: 22rpx; padding: 8rpx 18rpx; border-radius: 8rpx; background: #fdf2e6; color: #c07a1a; }
.rs-btn-mini.paid { background: #e8f7e8; color: #1a7a1a; }
.rs-btn-mini.danger { background: #fdecec; color: #d9534f; }
.rs-mask { position: fixed; inset: 0; background: rgba(0,0,0,0.45); z-index: 90; }
.rs-sheet { position: fixed; left: 0; right: 0; bottom: 0; background: #fff; border-radius: 24rpx 24rpx 0 0; z-index: 91; padding-bottom: 40rpx; }
.rs-sheet-title { text-align: center; font-size: 30rpx; font-weight: 600; padding: 28rpx 0 10rpx; }
.rs-field { padding: 16rpx 32rpx; }
.rs-label { display: block; font-size: 25rpx; color: #666; margin-bottom: 8rpx; }
.rs-input { border: 1rpx solid #e5e5e5; border-radius: 10rpx; padding: 14rpx 20rpx; font-size: 27rpx; }
.rs-picker { border: 1rpx solid #e5e5e5; border-radius: 10rpx; padding: 14rpx 20rpx; font-size: 27rpx; }
.rs-sheet-btn { margin: 20rpx 32rpx 0; background: #1aad19; color: #fff; font-size: 29rpx; }
.rs-btn-export { margin-left: 16rpx; }
