/* pages/admin/raceReview/raceReview.wxss */
.rr-page { padding: 24rpx; padding-bottom: 60rpx; }
.loading { text-align: center; color: #999; padding: 80rpx 0; }
.rr-tip { background: #f7faf7; border: 1rpx solid #d6ead6; border-radius: 12rpx; padding: 16rpx 20rpx; font-size: 22rpx; color: #667; line-height: 1.7; margin-bottom: 20rpx; }
.rr-empty { text-align: center; color: #aaa; padding: 100rpx 0; font-size: 26rpx; }
.rr-card { background: #fff; border-radius: 14rpx; padding: 24rpx; margin-bottom: 20rpx; box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04); }
.rr-head { display: flex; align-items: baseline; gap: 14rpx; margin-bottom: 10rpx; }
.rr-name { font-size: 30rpx; font-weight: 700; }
.rr-event { font-size: 22rpx; color: #999; }
.rr-meta { display: flex; flex-wrap: wrap; gap: 10rpx 18rpx; margin-bottom: 10rpx; }
.rr-meta-item { font-size: 24rpx; color: #666; }
.rr-meta-item.result { font-weight: 700; color: #1a7a1a; }
.rr-meta-item.warn { color: #c07a1a; }
.rr-note { display: block; font-size: 23rpx; color: #888; margin-bottom: 8rpx; }
.rr-flag { background: #fdf2e6; color: #c07a1a; border-radius: 8rpx; padding: 10rpx 16rpx; font-size: 22rpx; margin-bottom: 10rpx; }
.rr-imgs { display: flex; flex-wrap: wrap; gap: 12rpx; margin-bottom: 16rpx; }
.rr-img { width: 200rpx; height: 200rpx; border-radius: 10rpx; }
.rr-noimg { font-size: 22rpx; color: #bbb; align-self: center; }
.rr-btns { display: flex; gap: 16rpx; }
.rr-btn { flex: 1; text-align: center; padding: 16rpx 0; border-radius: 10rpx; font-size: 27rpx; }
.rr-btn-main { background: #1aad19; color: #fff; }
.rr-btn-ghost { border: 1rpx solid #eec4c2; color: #d9534f; background: #fff; }
