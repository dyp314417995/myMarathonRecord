/* pages/admin/makeup-cards/makeup-cards.wxss */
.section-title { font-size: 30rpx; font-weight: 600; color: #666; margin: 36rpx 24rpx 0; }

.mc-tip { margin-bottom: 8rpx; }
.mc-tip-title { display: block; font-size: 28rpx; font-weight: 600; color: #333; margin-bottom: 12rpx; }
.mc-tip-line { display: block; font-size: 24rpx; color: #999; line-height: 1.7; }

.mc-form { margin-bottom: 8rpx; }

.user-trigger { display: flex; align-items: center; }
.user-trigger .placeholder { color: #bbb; }
.selected-names { flex: 1; font-size: 26rpx; color: #333; word-break: break-all; }
.selected-more { font-size: 24rpx; color: #1aad19; flex-shrink: 0; margin-left: 12rpx; }

.empty-tight { padding: 24rpx; text-align: center; font-size: 24rpx; color: #bbb; }

.log-card { padding: 20rpx 28rpx; margin: 12rpx; }
.log-row { display: flex; justify-content: space-between; align-items: center; }
.log-op { font-size: 28rpx; font-weight: 600; }
.log-target { font-size: 22rpx; color: #1aad19; background: #e8f5e9; padding: 4rpx 14rpx; border-radius: 8rpx; max-width: 60%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.log-detail { display: block; font-size: 24rpx; color: #666; margin-top: 8rpx; }
.log-time { display: block; font-size: 22rpx; color: #bbb; margin-top: 4rpx; }

/* 用户选择弹窗 */
.modal-mask { position: fixed; top:0; left:0; right:0; bottom:0; background: rgba(0,0,0,0.5); z-index:100; }
.modal-box { position: fixed; top: 15%; left: 32rpx; right: 32rpx; bottom: 20%; background: #fff; border-radius: 20rpx; padding: 32rpx; z-index:101; overflow:hidden; display:flex; flex-direction:column; }
.modal-title { font-size: 32rpx; font-weight: 600; text-align: center; margin-bottom: 24rpx; }
.user-list { flex:1; margin-top:16rpx; }
.picker-item { padding: 20rpx 16rpx; border-bottom: 1rpx solid #f7f7f7; font-size: 26rpx; display: flex; align-items: center; gap: 12rpx; }
.picker-check { font-size: 28rpx; width: 40rpx; }
.picker-name { flex: 1; min-width: 0; }

.form-tip { font-size: 22rpx; color: #ff9800; margin-top: 8rpx; display: block; }
