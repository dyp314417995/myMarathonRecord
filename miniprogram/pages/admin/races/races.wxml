<!-- pages/admin/races/races.wxml -->
<view class="races-page">
  <view wx:if="{{!isAdmin}}" class="empty-state"><text>仅管理员可操作</text></view>
  <view wx:else>

    <view class="admin-filter">
      <input class="filter-input" placeholder="搜索赛事名称" value="{{adminSearch}}" bindinput="onAdminSearch" />
      <view class="filter-row">
        <text class="filter-chip {{adminType === '' ? 'on' : ''}}" data-v="" bindtap="onAdminFilter" data-field="type">全部</text>
        <text class="filter-chip {{adminType === 'full' ? 'on' : ''}}" data-v="full" bindtap="onAdminFilter" data-field="type">全马</text>
        <text class="filter-chip {{adminType === 'half' ? 'on' : ''}}" data-v="half" bindtap="onAdminFilter" data-field="type">半马</text>
        <text class="filter-chip {{adminType === '10k' ? 'on' : ''}}" data-v="10k" bindtap="onAdminFilter" data-field="type">10K</text>
      </view>
      <view class="filter-row">
        <text class="filter-chip {{adminLevel === '' ? 'on' : ''}}" data-v="" bindtap="onAdminFilter" data-field="level">全部</text>
        <text class="filter-chip {{adminLevel === 'A' ? 'on' : ''}}" data-v="A" bindtap="onAdminFilter" data-field="level">A级</text>
        <text class="filter-chip {{adminLevel === 'B' ? 'on' : ''}}" data-v="B" bindtap="onAdminFilter" data-field="level">B级</text>
        <text class="filter-chip {{adminLevel === 'C' ? 'on' : ''}}" data-v="C" bindtap="onAdminFilter" data-field="level">C级</text>
      </view>
      <view class="filter-row">
        <text class="filter-chip {{adminLabel === '' ? 'on' : ''}}" data-v="" bindtap="onAdminFilter" data-field="label">全部</text>
        <text class="filter-chip {{adminLabel === '白金标' ? 'on' : ''}}" data-v="白金标" bindtap="onAdminFilter" data-field="label">白金标</text>
        <text class="filter-chip {{adminLabel === '金标' ? 'on' : ''}}" data-v="金标" bindtap="onAdminFilter" data-field="label">金标</text>
        <text class="filter-chip {{adminLabel === '精英标' ? 'on' : ''}}" data-v="精英标" bindtap="onAdminFilter" data-field="label">精英标</text>
        <text class="filter-chip {{adminLabel === '普通标' ? 'on' : ''}}" data-v="普通标" bindtap="onAdminFilter" data-field="label">普通标</text>
      </view>
      <view class="filter-row">
        <text class="filter-chip {{adminRegStatus === '' ? 'on' : ''}}" data-v="" bindtap="onAdminFilter" data-field="regStatus">状态全部</text>
        <text class="filter-chip {{adminRegStatus === '待确定' ? 'on' : ''}}" data-v="待确定" bindtap="onAdminFilter" data-field="regStatus">待确定</text>
        <text class="filter-chip {{adminRegStatus === '报名中' ? 'on' : ''}}" data-v="报名中" bindtap="onAdminFilter" data-field="regStatus">报名中</text>
        <text class="filter-chip {{adminRegStatus === '待报名' ? 'on' : ''}}" data-v="待报名" bindtap="onAdminFilter" data-field="regStatus">待报名</text>
        <text class="filter-chip {{adminRegStatus === '待开赛' ? 'on' : ''}}" data-v="待开赛" bindtap="onAdminFilter" data-field="regStatus">待开赛</text>
        <text class="filter-chip {{adminRegStatus === '待出签' ? 'on' : ''}}" data-v="待出签" bindtap="onAdminFilter" data-field="regStatus">待出签</text>
        <text class="filter-chip {{adminRegStatus === '已结束' ? 'on' : ''}}" data-v="已结束" bindtap="onAdminFilter" data-field="regStatus">已结束</text>
        <text class="filter-chip {{adminRegStatus === '取消' ? 'on' : ''}}" data-v="取消" bindtap="onAdminFilter" data-field="regStatus">取消</text>
      </view>
    </view>
    <view wx:if="{{raceList.length === 0}}" class="empty-state"><text>暂无赛事</text></view>
    <view class="card race-card" wx:for="{{raceList}}" wx:key="_id" bindtap="onRaceDetailAdmin" data-id="{{item._id}}">
      <view class="race-card-row">
        <view class="race-info">
          <text class="race-name">{{item.name}}</text>
          <text class="race-meta">{{item.fmtDate}} · {{item.province || item.city || '未知'}} · {{item.raceTypesStr}}<text wx:if="{{item.raceLevel}}"> · {{item.raceLevel}}级</text>{{item.label ? ' · ' + item.label : ''}}{{item.scale ? ' · 规模' + item.scale : ''}}<text wx:if="{{item.regStatus}}"> · {{item.regStatus}}</text></text>
          <text class="tag tag-green" wx:if="{{item.status === 'upcoming'}}">{{item.countdown}}</text>
          <text class="tag tag-gray" wx:else>{{item.countdown}}</text>
        </view>
        <view class="race-actions">
          <text class="act" data-id="{{item._id}}" catchtap="onEdit">✏️</text>
          <text class="act" data-id="{{item._id}}" catchtap="onDup">📋</text>
          <text class="act" data-id="{{item._id}}" data-name="{{item.name}}" catchtap="onShare">📱</text>
          <text class="act" data-id="{{item._id}}" data-name="{{item.name}}" catchtap="onManageReviews">📝</text>
          <text class="act del" data-id="{{item._id}}" catchtap="onDel">🗑</text>
        </view>
      </view>
    </view>

    <view wx:if="{{adminHasMore}}" class="load-more" bindtap="onLoadMoreRaces">加载更多</view>

    <!-- 赛事表单弹窗 -->
    <view class="modal-mask" wx:if="{{showForm}}" catchtap="onHideForm"></view>
    <view class="modal-box" wx:if="{{showForm}}">
      <view class="modal-header">
        <text>{{editingId ? '编辑' : '添加'}}赛事</text>
        <text class="modal-close" bindtap="onHideForm">✕</text>
      </view>
      <!-- 粘贴全文快速提取 -->
      <view wx:if="{{!showPaste}}" class="paste-trigger" bindtap="onTogglePaste">
        <text>📋 粘贴报名须知全文，自动提取时间节点</text>
      </view>
      <view wx:if="{{showPaste}}" class="paste-area">
        <textarea class="paste-input" placeholder="粘贴赛事报名须知/竞赛规程全文..." value="{{pasteText}}" bindinput="onPasteInput" auto-height maxlength="5000" />
        <view class="paste-actions">
          <button class="btn-sm btn-outline" bindtap="onPasteParse" loading="{{parsing}}">提取时间节点</button>
          <text class="paste-close" bindtap="onTogglePaste">收起</text>
        </view>
      </view>
            <text class="form-label">赛事名称 *</text>
      <view class="name-input-wrap">
        <input class="form-input" placeholder="如：北京马拉松2026（建议带年份）" value="{{form.name}}" data-k="name" bindinput="onInput" bindblur="onNameBlur" />
        <text wx:if="{{nameDupStatus === 'checking'}}" class="name-status checking">校验中...</text>
        <text wx:elif="{{nameDupStatus === 'dup'}}" class="name-status dup">⚠️ 同名赛事已存在</text>
        <text wx:elif="{{nameDupStatus === 'ok'}}" class="name-status ok">✓ 名称可用</text>
      </view>
      <text class="form-label">赛事组（不带年份，同赛事跨年关联）</text>
      <input class="form-input" placeholder="如：北京马拉松" value="{{form.raceGroup}}" data-k="raceGroup" bindinput="onInput" />
      <text class="form-label">比赛日期 *</text>
      <picker mode="date" value="{{form.date}}" bindchange="onDateChange">
        <view class="tl-date-pick"><text class="{{form.date ? '' : 'placeholder'}}">{{form.date || '选择日期'}}</text></view>
      </picker>
      <text class="form-label">赛事等级</text>
      <view class="btn-row">
        <text class="opt-btn {{form.raceLevel === '' ? 'on' : ''}}" data-v="" bindtap="onFormLevel">未填</text>
        <text class="opt-btn {{form.raceLevel === 'A' ? 'on' : ''}}" data-v="A" bindtap="onFormLevel">A</text>
        <text class="opt-btn {{form.raceLevel === 'B' ? 'on' : ''}}" data-v="B" bindtap="onFormLevel">B</text>
        <text class="opt-btn {{form.raceLevel === 'C' ? 'on' : ''}}" data-v="C" bindtap="onFormLevel">C</text>
      </view>

      <text class="form-label">标牌</text>
      <view class="btn-row">
        <text class="opt-btn {{form.label === '' ? 'on' : ''}}" data-v="" bindtap="onFormLabel">未填</text>
        <text class="opt-btn {{form.label === '普通标' ? 'on' : ''}}" data-v="普通标" bindtap="onFormLabel">普通</text>
        <text class="opt-btn {{form.label === '精英标' ? 'on' : ''}}" data-v="精英标" bindtap="onFormLabel">精英</text>
        <text class="opt-btn {{form.label === '金标' ? 'on' : ''}}" data-v="金标" bindtap="onFormLabel">金标</text>
        <text class="opt-btn {{form.label === '白金标' ? 'on' : ''}}" data-v="白金标" bindtap="onFormLabel">白金</text>
      </view>
      <text class="form-label">总规模</text>
      <input class="form-input" placeholder="如：35000" value="{{form.scale}}" data-k="scale" bindinput="onInput" />
      <text class="form-label">分项规模</text>
      <input class="form-input" placeholder="如：18000/25000/31000" value="{{form.subScale}}" data-k="subScale" bindinput="onInput" />
      <text class="form-label">报名费</text>
      <input class="form-input" placeholder="如：200元/人 或 US$90/85/70" value="{{form.fee}}" data-k="fee" bindinput="onInput" />
      <text class="form-label">主办单位</text>
      <input class="form-input" placeholder="如：石家庄市人民政府" value="{{form.organizer}}" data-k="organizer" bindinput="onInput" />
      <text class="form-label">运营单位</text>
      <input class="form-input" placeholder="如：河北野人体育文化发展有限公司" value="{{form.operator}}" data-k="operator" bindinput="onInput" />
      <view style="display:flex;gap:12rpx;">
        <view style="flex:1;">
          <text class="form-label">联系电话</text>
          <input class="form-input" placeholder="如：0311-87710266" value="{{form.contactPhone}}" data-k="contactPhone" bindinput="onInput" />
        </view>
        <view style="flex:1;">
          <text class="form-label">官方邮箱</text>
          <input class="form-input" placeholder="如：xxx@example.com" value="{{form.contactEmail}}" data-k="contactEmail" bindinput="onInput" />
        </view>
      </view>
      <text class="form-label">微信公众号</text>
      <input class="form-input" placeholder="如：石家庄马拉松赛" value="{{form.wechatAccount}}" data-k="wechatAccount" bindinput="onInput" />
      <text class="form-label">官网</text>
      <input class="form-input" placeholder="https://" value="{{form.website}}" data-k="website" bindinput="onInput" />
      <text class="form-label">报名方式</text>
      <view class="btn-row">
        <text class="opt-btn {{form.mechanism === '' ? 'on' : ''}}" data-v="" bindtap="onFormMechanism">未填</text>
        <text class="opt-btn {{form.mechanism === '抽签' ? 'on' : ''}}" data-v="抽签" bindtap="onFormMechanism">抽签</text>
        <text class="opt-btn {{form.mechanism === '先到先得' ? 'on' : ''}}" data-v="先到先得" bindtap="onFormMechanism">先到先得</text>
      </view>

      <text class="form-label">缴费方式</text>
      <view class="btn-row">
        <text class="opt-btn {{form.payment === '' ? 'on' : ''}}" data-v="" bindtap="onFormPayment">未填</text>
        <text class="opt-btn {{form.payment === '报名时缴费' ? 'on' : ''}}" data-v="报名时缴费" bindtap="onFormPayment">报名时缴费</text>
        <text class="opt-btn {{form.payment === '中签后缴费' ? 'on' : ''}}" data-v="中签后缴费" bindtap="onFormPayment">中签后缴费</text>
      </view>
      <text class="form-label">报名渠道</text>
      <input class="form-input" placeholder="如：官网/微信/小程序 / 数字心动 / 马拉马拉" value="{{form.signupChannels}}" data-k="signupChannels" bindinput="onInput" />
      <text class="form-label">体检报告</text>
      <input class="form-input" placeholder="如：自行评估 / 必须 / 未提及 / 可用完赛证书" value="{{form.medicalReport}}" data-k="medicalReport" bindinput="onInput" />
      <text class="form-label">完赛经历要求</text>
      <input class="form-input" placeholder="如：半程或以上 / 10km及以上 / 未提及" value="{{form.finishRequirement}}" data-k="finishRequirement" bindinput="onInput" />
      <text class="form-label">退出机制</text>
      <input class="form-input" placeholder="如：无 / 有 / 详细退费规则" value="{{form.refundRule}}" data-k="refundRule" bindinput="onInput" />
      <text class="form-label">起点</text>
      <input class="form-input" placeholder="如：解放广场" value="{{form.startPoint}}" data-k="startPoint" bindinput="onInput" />
      <text class="form-label">奖牌图 URL（表格导入，可改）</text>
      <input class="form-input" placeholder="https:// 奖牌图片" value="{{form.medalImage}}" data-k="medalImage" bindinput="onInput" />
      <text class="form-label">路线图 URL（表格导入，可改）</text>
      <input class="form-input" placeholder="https:// 比赛路线图" value="{{form.routeMap}}" data-k="routeMap" bindinput="onInput" />
<text class="form-label">时间节点</text>
      <block wx:for="{{timelineNodes}}" wx:key="label" wx:for-item="node" wx:for-index="idx">
        <view wx:if="{{node.label === '鸣枪开跑'}}" class="gun-block">
          <text class="tl-label" style="margin-bottom:8rpx;">{{node.label}}</text>
          <picker mode="date" value="{{node.date}}" bindchange="onTimelineDate" data-idx="{{idx}}">
            <view class="tl-date-pick" style="margin-bottom:8rpx;"><text class="{{node.date ? '' : 'placeholder'}}">{{node.date || '日期'}}</text></view>
          </picker>
          <view class="gun-row" wx:for="{{gunTimes}}" wx:key="index" wx:for-item="g" wx:for-index="gi">
            <input class="gun-zone-input" placeholder="分区" value="{{g.zone}}" data-idx="{{gi}}" data-field="zone" bindinput="onGunTimeInput" />
            <picker mode="time" value="{{g.time || '07:00'}}" bindchange="onGunTimeTime" data-idx="{{gi}}">
              <view class="gun-time-pick">{{g.time || '07:00'}}</view>
            </picker>
            <text class="gun-del" wx:if="{{gunTimes.length > 1}}" catchtap="onDelGunTime" data-idx="{{gi}}">🗑</text>
          </view>
          <view class="add-guntime" bindtap="onAddGunTime"><text>+ 添加发枪分区</text></view>
        </view>
        <view class="timeline-form" wx:else>
          <text class="tl-label">{{node.label}}</text>
          <view class="tl-pickers">
            <picker mode="date" value="{{node.date}}" bindchange="onTimelineDate" data-idx="{{idx}}">
              <view class="tl-date-pick"><text class="{{node.date ? '' : 'placeholder'}}">{{node.date || '日期'}}</text></view>
            </picker>
            <picker mode="time" value="{{node.time || '12:00'}}" bindchange="onTimelineTime" data-idx="{{idx}}">
              <view class="tl-date-pick tl-time-pick"><text class="{{node.time ? '' : 'placeholder'}}">{{node.time || '时间'}}</text></view>
            </picker>
            <text class="tl-clear" wx:if="{{node.date || node.time}}" catchtap="onClearTime" data-idx="{{idx}}">✕</text>
          </view>
        </view>
      </block>
      <text class="form-label">赛事图片（选填，最多9张）</text>
      <view class="poster-grid count-{{posterTemp.length === 1 ? 1 : (posterTemp.length === 2 || posterTemp.length === 4 ? 2 : 3)}}">
        <view class="poster-grid-item" wx:for="{{posterTemp}}" wx:key="*this" wx:for-index="idx">
          <image src="{{item}}" mode="aspectFill" class="poster-grid-img" data-idx="{{idx}}" bindtap="onPreviewPoster" />
          <text class="poster-grid-del" data-idx="{{idx}}" catchtap="onDelPosterSmall">✕</text>
          <view wx:if="{{posterTemp.length > 1}}" class="poster-grid-move">
            <text class="poster-move-btn {{idx === 0 ? 'disabled' : ''}}" data-idx="{{idx}}" catchtap="onMovePosterLeft">‹</text>
            <text class="poster-move-btn {{idx === posterTemp.length - 1 ? 'disabled' : ''}}" data-idx="{{idx}}" catchtap="onMovePosterRight">›</text>
          </view>
        </view>
        <view wx:if="{{posterTemp.length < 9}}" class="poster-grid-item poster-grid-upload" bindtap="onChoosePoster">
          <text class="poster-grid-add">+</text>
          <text class="poster-grid-count">{{posterTemp.length}}/9</text>
        </view>
      </view>
      <view class="modal-actions" style="margin-top:24rpx;">
        <button class="btn-outline" bindtap="onHideForm">取消</button>
        <button class="btn-primary" bindtap="onSave">保存</button>
      </view>
    </view>

    <!-- 评价管理弹窗 -->
    <view class="modal-mask" wx:if="{{showReviews}}" catchtap="onHideReviews"></view>
    <view class="modal-box" wx:if="{{showReviews}}">
      <view class="modal-header">
        <text>评价管理 - {{reviewEventName}}</text>
        <text class="modal-close" bindtap="onHideReviews">✕</text>
      </view>
      <view wx:if="{{reviewList.length === 0}}" class="empty-tight"><text>暂无评价</text></view>
      <scroll-view scroll-y class="review-scroll">
        <view class="rv-item" wx:for="{{reviewList}}" wx:key="_id">
          <view class="rv-user">
            <text class="rv-name">{{item.userName}}</text>
            <text class="rv-time">{{item.fmtTime}}</text>
          </view>
          <text class="rv-scores">{{item.fmtScores}}</text>
          <view wx:if="{{item.tags && item.tags.length}}" class="req-tags">
            <text class="race-tag" wx:for="{{item.tags}}" wx:key="*this">{{item}}</text>
          </view>
          <text class="rv-del" data-id="{{item._id}}" catchtap="onDelReview">🗑 删除</text>
        </view>
      </scroll-view>
    </view>
  </view>

  <!-- 海报预览弹窗 -->
  <view class="poster-full" wx:if="{{showPoster}}">
    <view class="poster-full-top">
      <text class="poster-full-counter">{{posterIdx + 1}} / {{posterTemp.length}}</text>
      <text class="poster-full-close" bindtap="onHidePoster">✕</text>
    </view>
    <swiper class="poster-full-swiper" current="{{posterIdx}}" bindchange="onPosterSwiperChange" duration="200">
      <swiper-item wx:for="{{posterTemp}}" wx:key="*this">
        <image src="{{item}}" mode="aspectFit" class="poster-full-img" />
      </swiper-item>
    </swiper>
  </view>

  <!-- 隐藏Canvas用于合成二维码海报 -->
  <canvas type="2d" id="qrPosterCanvas" style="width:400px;height:520px;position:fixed;left:9999px;top:9999px;z-index:-1;"></canvas>

  <!-- QR 弹窗 -->
  <view class="modal-mask" wx:if="{{showQR}}" catchtap="onHideQR"></view>
  <view class="modal-box" wx:if="{{showQR}}">
    <view class="modal-header">
      <text>赛事分享</text>
      <text class="modal-close" bindtap="onHideQR">✕</text>
    </view>
    <view class="qr-race-info" wx:if="{{showQRText}}">
      <text class="qr-race-name">{{sharingRaceName}}</text>
      <text wx:if="{{sharingRaceInfo.date}}" class="qr-race-meta">{{sharingRaceInfo.date}}{{sharingRaceInfo.city ? ' · ' + sharingRaceInfo.city : ''}}</text>
      <text wx:if="{{sharingRaceInfo.type || sharingRaceInfo.level || sharingRaceInfo.label}}" class="qr-race-meta">{{sharingRaceInfo.type}}{{sharingRaceInfo.level ? ' · ' + sharingRaceInfo.level + '级' : ''}}{{sharingRaceInfo.label ? ' · ' + sharingRaceInfo.label : ''}}</text>
    </view>
    <image wx:if="{{qrFileID}}" src="{{qrFileID}}" mode="widthFix" class="qr-img" show-menu-by-longpress="{{true}}" />
    <view class="qr-tip" wx:if="{{showQRText}}">扫码可查看赛事详情、标记和评分</view>
  </view>
</view>
