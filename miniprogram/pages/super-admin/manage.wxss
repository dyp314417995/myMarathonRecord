/* pages/super-admin/manage.wxss */
.section-title {
  font-size: 30rpx; font-weight: 600; padding: 32rpx 24rpx 12rpx;
}

.admin-card { padding: 24rpx 28rpx; }
.admin-header { display: flex; align-items: flex-start; }
.admin-avatar {
  width: 72rpx; height: 72rpx; border-radius: 50%;
  background: #f0f0f0; flex-shrink: 0;
}
.admin-info { flex: 1; margin-left: 20rpx; min-width: 0; }
.admin-name { font-size: 28rpx; font-weight: 600; display: block; }
.admin-date { font-size: 24rpx; color: #999; margin-top: 4rpx; display: block; }
.admin-perms { display: flex; flex-wrap: wrap; gap: 8rpx; margin-top: 8rpx; }
.admin-allprovinces { font-size: 22rpx; color: #1aad19; display: block; margin-top: 6rpx; }

.admin-provinces {
  display: flex; flex-wrap: wrap; gap: 6rpx;
  margin: 8rpx 0;
}
.province-chip {
  font-size: 22rpx; color: #1aad19;
  background: #e8f5e9;
  padding: 2rpx 12rpx;
  border-radius: 6rpx;
}

.admin-actions { display: flex; justify-content: flex-end; gap: 16rpx; margin-top: 16rpx; padding-top: 16rpx; border-top: 1rpx solid #f5f5f5; }
.btn-revoke {
  background: #fff; color: #ff4d4f; border: 2rpx solid #ff4d4f;
  border-radius: 8rpx; padding: 10rpx 24rpx; font-size: 24rpx;
}
.btn-edit {
  background: #fff; color: #1aad19; border: 2rpx solid #1aad19;
  border-radius: 8rpx; padding: 10rpx 24rpx; font-size: 24rpx;
}
.edit-user-view {
  background: #f7f7f7; border-radius: 12rpx;
  padding: 20rpx; font-size: 28rpx; margin-top: 8rpx; color: #333;
}
.btn-area { padding: 24rpx; }

/* 弹窗 */
.modal-mask {
  position: fixed; top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.5); z-index: 100;
}
.modal-box {
  position: fixed; top: 15%; left: 32rpx; right: 32rpx; bottom: 40rpx;
  background: #fff; border-radius: 20rpx; padding: 32rpx;
  z-index: 101;
  display: flex; flex-direction: column;
}
/* 添加/编辑管理员弹窗：整体滚动方案（与 races 管理页一致，真机可靠）。
   不用 flex + scroll-view 组合——真机上 scroll-view 拿不到确定高度不滚，按钮被顶出屏外 */
.modal-box-scroll {
  display: block;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
}
.modal-box-inner { top: 10%; }
.modal-scroll {
  margin-top: 16rpx;
}
.modal-header {
  display: flex; align-items: center; justify-content: space-between;
  margin-bottom: 8rpx; padding-bottom: 12rpx; border-bottom: 1rpx solid #f5f5f5;
}
.modal-title { font-size: 32rpx; font-weight: 600; display: block; text-align: center; flex: 1; }
.modal-close { font-size: 36rpx; color: #999; padding: 0 8rpx; }

.user-picker { max-height: 300rpx; border: 1rpx solid #eee; border-radius: 12rpx; padding: 8rpx; }
.picker-item {
  padding: 20rpx 16rpx; border-radius: 8rpx; font-size: 26rpx;
  border-bottom: 1rpx solid #f7f7f7;
}
.picker-item:last-child { border-bottom: none; }
.picker-item.active { background: #e8f5e9; color: #1aad19; font-weight: 600; }

.perm-options { display: flex; gap: 16rpx; }
.perm-option {
  flex: 1; padding: 20rpx; border-radius: 12rpx;
  background: #f7f7f7; border: 2rpx solid #f7f7f7;
  text-align: center; font-size: 26rpx;
}
.perm-option.active { background: #e8f5e9; border-color: #1aad19; }

.form-label {
  font-size: 28rpx; color: #333;
  display: block; margin-top: 28rpx;
  font-weight: 500;
}
.form-tip {
  font-size: 22rpx; color: #bbb;
}
.form-row {
  display: flex; align-items: baseline; justify-content: space-between;
}
.form-input {
  background: #f7f7f7; border-radius: 12rpx;
  padding: 20rpx; font-size: 28rpx; margin-top: 8rpx;
}

/* 负责省份输入框（点击弹出选择） */
.province-input {
  background: #f7f7f7; border-radius: 12rpx;
  padding: 20rpx; font-size: 26rpx; margin-top: 8rpx;
  min-height: 64rpx;
  display: flex; flex-wrap: wrap; gap: 8rpx; align-items: center;
}
.province-input-chip {
  font-size: 24rpx; color: #1aad19;
  background: #e8f5e9;
  padding: 4rpx 14rpx; border-radius: 8rpx;
}
.province-input-placeholder {
  color: #bbb; font-size: 26rpx;
}

/* 省份多选弹窗 */
.province-picker-actions {
  display: flex; flex-direction: column; gap: 12rpx;
  margin-top: 8rpx;
}
.province-picker-btns {
  display: flex; gap: 12rpx;
  margin-top: 4rpx;
}
.picker-mini {
  font-size: 24rpx; color: #1aad19;
  padding: 6rpx 18rpx; background: #e8f5e9; border-radius: 8rpx;
}
.province-picker-list {
  flex: 1;
  height: 0;      /* 同上：scroll-view flex 布局需确定高度才能滚动 */
  min-height: 0;
  margin-top: 12rpx;
  border: 1rpx solid #eee; border-radius: 12rpx;
  padding: 4rpx;
  max-height: 50vh;
}
.province-picker-item {
  display: flex; justify-content: space-between; align-items: center;
  padding: 18rpx 20rpx;
  font-size: 28rpx;
  border-bottom: 1rpx solid #f7f7f7;
}
.province-picker-item:last-child { border-bottom: none; }
.province-picker-item.active { background: #e8f5e9; color: #1aad19; font-weight: 600; }
.picker-item-check { color: #1aad19; font-weight: 700; font-size: 28rpx; }

.modal-actions { display: flex; gap: 20rpx; margin-top: 24rpx; padding-top: 16rpx; }

.empty-tight { padding: 32rpx; text-align: center; font-size: 24rpx; color: #bbb; }
